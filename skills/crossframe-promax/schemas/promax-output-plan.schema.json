{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/promax-output-plan.schema.json",
  "title": "CrossFrame ProMax locked longform output plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "source_snapshot_sha256", "sections", "required_artifacts", "unexpanded_branch_ids", "coverage_complete", "locked_at"],
  "properties": {
    "schema_id": {"const": "crossframe.promax.v8.output-plan"},
    "schema_version": {"enum": [1, 2]},
    "run_id": {"$ref": "promax-common.schema.json#/$defs/runId"},
    "source_snapshot_sha256": {"$ref": "promax-common.schema.json#/$defs/v8SnapshotSha256"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    },
    "reader_projection": {"$ref": "#/$defs/readerProjection"},
    "required_artifacts": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "promax-common.schema.json#/$defs/relativePath"},
      "allOf": [
        {"contains": {"const": "promax-dossier.md"}},
        {"contains": {"const": "promax-concept-atlas.md"}},
        {"contains": {"const": "promax-case-and-countercase.md"}},
        {"contains": {"const": "promax-essay.md"}}
      ]
    },
    "unexpanded_branch_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
    "coverage_complete": {"type": "boolean"},
    "locked_at": {"$ref": "promax-common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": 1}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "sections": {"items": {"$ref": "#/$defs/sectionV1"}}
        },
        "not": {"required": ["reader_projection"]}
      },
      "else": {
        "required": ["reader_projection"],
        "properties": {
          "sections": {"items": {"$ref": "#/$defs/sectionV2"}}
        }
      }
    },
    {
      "if": {"properties": {"coverage_complete": {"const": true}}, "required": ["coverage_complete"]},
      "then": {"properties": {"unexpanded_branch_ids": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "sectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title", "concept_ids", "claim_ids", "example_ids", "counterexample_ids", "judgment_ids", "artifact_paths"],
      "properties": {
        "section_id": {"type": "string", "pattern": "^SECTION-[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"},
        "title": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/claimId"}
        },
        "example_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "counterexample_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "judgment_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "artifact_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/relativePath"}
        }
      }
    },
    "sectionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title", "concept_ids", "claim_ids", "example_ids", "counterexample_ids", "judgment_ids", "artifact_paths"],
      "properties": {
        "section_id": {"$ref": "#/$defs/sectionId"},
        "title": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/claimId"}
        },
        "mechanism_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "path_node_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "example_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "counterexample_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "judgment_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "artifact_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/relativePath"}
        }
      }
    },
    "sectionId": {
      "type": "string",
      "pattern": "^SECTION-[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "articleType": {
      "enum": [
        "reply",
        "public-commentary",
        "concept-explanation",
        "organization-review",
        "case-analysis",
        "debate-refutation",
        "reading-synthesis",
        "trend-deduction",
        "neutral-analysis"
      ]
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technique_id", "tier", "paragraph_action", "section_ids"],
      "properties": {
        "technique_id": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "tier": {"enum": ["core", "auxiliary"]},
        "paragraph_action": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        }
      }
    },
    "selectedTechniques": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/technique"},
      "allOf": [
        {
          "contains": {
            "properties": {"tier": {"const": "core"}},
            "required": ["tier"]
          },
          "minContains": 3,
          "maxContains": 3
        },
        {
          "contains": {
            "properties": {"tier": {"const": "auxiliary"}},
            "required": ["tier"]
          },
          "minContains": 0,
          "maxContains": 2
        }
      ]
    },
    "readerBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_id", "function", "section_ids", "claim_ids", "mechanism_ids", "evidence_refs", "core_concept_ids", "technique_ids"],
      "properties": {
        "beat_id": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "function": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/claimId"}
        },
        "mechanism_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "evidence_refs": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "core_concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "technique_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"}
      }
    },
    "readerProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["article_type", "house_voice_id", "thesis_claim_id", "core_concept_ids", "atlas_only_concept_ids", "selected_techniques", "reader_beats"],
      "properties": {
        "article_type": {"$ref": "#/$defs/articleType"},
        "house_voice_id": {"const": "crossframe-promax"},
        "thesis_claim_id": {"$ref": "promax-common.schema.json#/$defs/claimId"},
        "core_concept_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "atlas_only_concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "selected_techniques": {"$ref": "#/$defs/selectedTechniques"},
        "reader_beats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/readerBeat"}
        }
      }
    }
  }
}
