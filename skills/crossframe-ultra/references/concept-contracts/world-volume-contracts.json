  "clauses": [
    {
      "clause_id": "V82-CLAUSE-WORLD-OBJECT",
      "statement": "联合对象明确包含行动者 A、圈层 C、圈层关系 Rcc、成员与角色映射 Rac、物质状态 M、体验—意义状态 Ψ、通道与约束 Q、事件流 E、多时钟 T、尺度剖面 SP、证据状态 W 与同一性判据 K。",
      "source_anchors": [
        "V82-P1766"
      ]
    },
    {
      "clause_id": "V82-CLAUSE-WORLD-LOCALITY",
      "statement": "联合对象必须保留局部差异和跨边界通道，不得把所有相关对象合并为一个超圈层或宣称更高主体。",
      "source_anchors": [
        "V82-P1767"
      ]
    },
    {
      "clause_id": "V82-CLAUSE-WORLD-FIELDS",
      "statement": "证据、未知、残差和对象身份。",
      "source_anchors": [
        "V82-P1793"
      ]
    },
    {
      "clause_id": "V82-CLAUSE-WORLD-LOCAL-RELATION-GRAPH",
      "statement": "框架不要求每个节点只有一个父节点，也不把“上层”自动理解为更重要、更真实或更有权。每条边只表达一种已声明关系。若同一对圈层存在多条边，应分别记录通道和时间窗；若不同尺度的边不可比较，保持并列而不强制排序。",
      "source_anchors": [
        "V82-P1840"
      ]
    },
    {
      "clause_id": "V82-CLAUSE-WORLD-SNAPSHOT",
      "statement": "冻结快照必须记录关系、成员映射、M/Ψ、通道、约束、多时钟、尺度剖面、未知、残差和 K，并保留观察、支持、候选、争议、未知或不适用等状态。",
      "source_anchors": [
        "V82-P1915",
        "V82-P1916"
      ]
    },
    {
      "clause_id": "V82-CLAUSE-WORLD-WK-IDENTITY",
      "statement": "法二｜信息身份不得静默升级。报告不能自动成为观测，观测不能自动成为完整现实，模型信念不能自动成为事实，模拟不能自动成为证据或授权。快照中的每个值应标明状态：观察到、得到支持的假设、候选、争议、未知或不适用。source_K、target_K 和 identity_mapping 共同决定对象保持、转换或不可比；同名不是同一性证据。",
      "source_anchors": [
        "V82-P0852",
        "V82-P1916",
        "V82-P0998"
      ]
    },
    {
      "clause_id": "V82-CLAUSE-WORLD-LOCAL-DISTRIBUTION",
      "statement": "成员关系不是二值且永久的。记录应包括依据、起止时间、角色、承诺强度、实际参与、退出能力和争议。联合状态同时维护 M 与 Ψ。M 包括身体、时间、空间、资金、能源、设备、基础设施、产权、供应、照护和实际行动能力；Ψ 包括感受、期待、记忆、身份、信任、羞耻、希望、恐惧、承诺、价值冲突和合法性感知。每一步都要有载体、方向、时延和反例。推导先测量局部目标的预定改善，再沿 G2 指定通道追踪跨边界输出、风险、资源占用或信号，并以 G4/D3 检查目标尺度的闭合与对象转换。",
      "source_anchors": [
        "V82-P1843",
        "V82-P1864",
        "V82-P1865",
        "V82-P0755"
      ]
    },
    {
      "clause_id": "V82-CLAUSE-WORLD-GRAPH-CEILING",
      "statement": "它不能仅凭结构图回答未来必然怎样，也不能决定哪个圈层更值得保护、谁应承担成本或谁有权行动。事件传播、分叉和级联进入第十一部分；条件前瞻和有限选择进入第十二部分；规范、授权与保护仍由后续层承担。",
      "source_anchors": [
        "V82-P1929"
      ]
    }
  ]
}
