  "contract_id": "V82-CONTRACT-RECURSIVE-INFERENCE",
  "responsibility": "一至三阶递归、谱系、分支、合并、剪枝、停止、局部可预测性与按阶评价。",
  "source_anchors": [
    "V82-P2110",
    "V82-P2111",
