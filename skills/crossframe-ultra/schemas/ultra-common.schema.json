{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-common.schema.json",
  "title": "CrossFrame Ultra v8.2 common runtime definitions",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableString": {
      "oneOf": [
        {"$ref": "#/$defs/nonemptyString"},
        {"type": "null"}
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "frameworkRevision": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-r(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "phaseId": {
      "enum": ["U0", "U1", "U2", "U3", "U4", "U5", "U6", "U7", "U8", "U9", "U10", "U11", "U12"]
    },
    "runStatus": {
      "enum": ["created", "running", "interrupted", "blocked", "needs_attention", "failed", "cancelled", "complete"]
    },
    "compatibilityResult": {
      "enum": ["resume", "read-only", "fork-required", "reject"]
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "nonemptyIdentifierArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "hashArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "phaseArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/phaseId"}
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![/\\\\])(?!.*[/\\\\](?![\\s\\S]))(?!.*[/\\\\]{2})(?!.*[ .](?:[/\\\\]|(?![\\s\\S])))(?!.*(?:^|[/\\\\])(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/\\\\]*)?(?:[/\\\\]|(?![\\s\\S])))[^\\u0000-\\u001F\\u007F-\\u009F<>:\"|?*]+(?![\\s\\S])"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?![\\s\\S])"
    },
    "artifactHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"$ref": "#/$defs/mediaType"}
      }
    },
    "artifactHashArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactHash"}
    },
    "versionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_version",
        "framework_revision",
        "framework_raw_sha256",
        "framework_semantic_sha256",
        "runtime_version",
        "artifact_schema_version",
        "compiler_version",
        "validator_version",
        "article_contract_version",
        "source_tree_sha256"
      ],
      "properties": {
        "framework_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "framework_revision": {"$ref": "#/$defs/frameworkRevision"},
        "framework_raw_sha256": {"$ref": "#/$defs/sha256"},
        "framework_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_version": {"$ref": "#/$defs/semver"},
        "artifact_schema_version": {"type": "integer", "minimum": 0},
        "compiler_version": {"$ref": "#/$defs/semver"},
        "validator_version": {"$ref": "#/$defs/semver"},
        "article_contract_version": {"$ref": "#/$defs/semver"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "currentVersionBinding": {
      "allOf": [
        {"$ref": "#/$defs/versionBinding"},
        {
          "properties": {
            "framework_version": {"const": "8.2"},
            "framework_revision": {"const": "v8.2-r1"},
            "framework_raw_sha256": {"const": "608a4e4099b18c96c18ed3c92a2ab5cdacbd737daca4214c77debdd795da3a20"},
            "framework_semantic_sha256": {"const": "4b63a6455cf73c136ae18d124aeed4301267fd2da78cca79c74e2850fb2728b0"},
            "runtime_version": {"const": "1.0.0"},
            "artifact_schema_version": {"const": 1},
            "compiler_version": {"const": "1.0.0"},
            "validator_version": {"const": "1.0.0"},
            "article_contract_version": {"const": "1.0.0"}
          }
        }
      ]
    },
    "artifactEnvelope": {
      "type": "object",
      "required": ["schema_id", "schema_version", "run_id", "version_binding", "generated_at", "content_sha256"],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^crossframe\\.ultra\\.v82\\.[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "schema_version": {"const": 1},
        "run_id": {"$ref": "#/$defs/runId"},
        "version_binding": {"$ref": "#/$defs/currentVersionBinding"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "phaseArtifactEnvelope": {
      "allOf": [
        {"$ref": "#/$defs/artifactEnvelope"},
        {
          "type": "object",
          "required": ["phase_id"],
          "properties": {
            "phase_id": {"$ref": "#/$defs/phaseId"}
          }
        }
      ]
    },
    "namedVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": {"$ref": "#/$defs/nonemptyString"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "unit": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "localState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "variables"],
      "properties": {
        "state_id": {"$ref": "#/$defs/identifier"},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/namedVariable"}
        }
      }
    },
    "scaleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spatial", "temporal", "organizational", "institutional", "material", "informational", "relational", "power", "risk"],
      "properties": {
        "spatial": {"$ref": "#/$defs/nonemptyString"},
        "temporal": {"$ref": "#/$defs/nonemptyString"},
        "organizational": {"$ref": "#/$defs/nonemptyString"},
        "institutional": {"$ref": "#/$defs/nonemptyString"},
        "material": {"$ref": "#/$defs/nonemptyString"},
        "informational": {"$ref": "#/$defs/nonemptyString"},
        "relational": {"$ref": "#/$defs/nonemptyString"},
        "power": {"$ref": "#/$defs/nonemptyString"},
        "risk": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "locatedUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "location_ref", "description"],
      "properties": {
        "unknown_id": {"$ref": "#/$defs/identifier"},
        "location_ref": {"$ref": "#/$defs/identifier"},
        "description": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "locatedResidual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residual_id", "location_ref", "description"],
      "properties": {
        "residual_id": {"$ref": "#/$defs/identifier"},
        "location_ref": {"$ref": "#/$defs/identifier"},
        "description": {"$ref": "#/$defs/nonemptyString"}
      }
    }
  }
}
