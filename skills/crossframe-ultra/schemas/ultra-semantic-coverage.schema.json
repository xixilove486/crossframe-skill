{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-semantic-coverage.schema.json",
  "title": "CrossFrame Ultra exact article semantic coverage",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": [
        "output_plan_artifact_sha256",
        "semantic_universe_sha256",
        "article_sha256",
        "required_unit_kinds",
        "mappings",
        "missing_unit_ids",
        "coverage_percent",
        "coverage_complete"
      ],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.semantic-coverage"},
        "phase_id": {"const": "U11"},
        "output_plan_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "semantic_universe_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "article_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "required_unit_kinds": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/unitKind"},
          "allOf": [
            {"contains": {"const": "claim"}},
            {"contains": {"const": "evidence"}},
            {"contains": {"const": "unknown"}},
            {"contains": {"const": "circle-relation"}},
            {"contains": {"const": "scale-transform"}},
            {"contains": {"const": "translation-loss"}},
            {"contains": {"const": "mechanism"}},
            {"contains": {"const": "branch"}},
            {"contains": {"const": "residual"}},
            {"contains": {"const": "forecast"}},
            {"contains": {"const": "verdict"}},
            {"contains": {"const": "action"}},
            {"contains": {"const": "reversal-condition"}}
          ]
        },
        "mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/mapping"}
        },
        "missing_unit_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "coverage_complete": {"type": "boolean"}
      }
    },
    {
      "if": {
        "properties": {"coverage_complete": {"const": true}},
        "required": ["coverage_complete"]
      },
      "then": {
        "properties": {
          "mappings": {
            "minItems": 13,
            "items": {
              "properties": {
                "source_refs": {"minItems": 1}
              }
            },
            "allOf": [
              {"contains": {"properties": {"unit_kind": {"const": "claim"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "evidence"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "unknown"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "circle-relation"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "scale-transform"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "translation-loss"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "mechanism"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "branch"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "residual"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "forecast"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "verdict"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "action"}}, "required": ["unit_kind"]}},
              {"contains": {"properties": {"unit_kind": {"const": "reversal-condition"}}, "required": ["unit_kind"]}}
            ]
          },
          "missing_unit_ids": {"maxItems": 0},
          "coverage_percent": {"const": 100}
        }
      },
      "else": {
        "properties": {
          "missing_unit_ids": {"minItems": 1},
          "coverage_percent": {"type": "number", "minimum": 0, "exclusiveMaximum": 100}
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "unitKind": {
      "enum": [
        "claim",
        "evidence",
        "unknown",
        "circle-relation",
        "scale-transform",
        "translation-loss",
        "mechanism",
        "branch",
        "residual",
        "forecast",
        "verdict",
        "action",
        "reversal-condition"
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "unit_kind", "section_id", "normalized_excerpt", "source_refs"],
      "properties": {
        "unit_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "unit_kind": {"$ref": "#/$defs/unitKind"},
        "section_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "normalized_excerpt": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "source_refs": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"}
      }
    }
  }
}
