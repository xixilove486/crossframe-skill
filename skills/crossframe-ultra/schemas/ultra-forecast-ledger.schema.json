{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-forecast-ledger.schema.json",
  "title": "CrossFrame Ultra append-only forecast and resolution ledger",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["forecasts", "resolutions"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.forecast-ledger"},
        "phase_id": {"const": "U9"},
        "forecasts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/forecast"}},
        "resolutions": {"type": "array", "items": {"$ref": "#/$defs/resolution"}}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forecast_id", "direction", "time_window", "indicator", "resolution_rule", "evidence_cutoff", "branch_refs", "node_refs", "status", "probability", "reference_class", "calibration_basis", "probability_admissible"],
      "properties": {
        "forecast_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "direction": {"enum": ["increase", "decrease", "stable", "threshold-crossing", "branch-dependent"]},
        "time_window": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "indicator": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "resolution_rule": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "evidence_cutoff": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
        "branch_refs": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "node_refs": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "status": {"enum": ["open", "resolved", "expired", "withdrawn"]},
        "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reference_class": {"$ref": "ultra-common.schema.json#/$defs/nullableString"},
        "calibration_basis": {"$ref": "ultra-common.schema.json#/$defs/nullableString"},
        "probability_admissible": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"probability_admissible": {"const": true}}},
          "then": {
            "properties": {
              "probability": {"type": "number"},
              "reference_class": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "calibration_basis": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          },
          "else": {"properties": {"probability": {"type": "null"}}}
        }
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_id", "forecast_id", "resolved_at", "outcome", "observed_value", "original_forecast_sha256"],
      "properties": {
        "resolution_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "forecast_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "resolved_at": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
        "outcome": {"enum": ["correct", "incorrect", "indeterminate", "partial"]},
        "observed_value": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "original_forecast_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
      }
    }
  }
}
