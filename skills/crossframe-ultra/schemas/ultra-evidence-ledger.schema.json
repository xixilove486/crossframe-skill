{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-evidence-ledger.schema.json",
  "title": "CrossFrame Ultra frozen evidence ledger",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["evidence_cutoff", "entries", "unknowns"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.evidence-ledger"},
        "phase_id": {"const": "U3"},
        "evidence_cutoff": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceEntry"}
        },
        "unknowns": {
          "type": "array",
          "items": {"$ref": "#/$defs/unknown"}
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "identity", "statement", "source_refs", "observed_at", "confidence", "event_date", "publication_date", "interest", "upstream_lineage", "supported_claim", "cannot_prove", "attribution"],
      "properties": {
        "evidence_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "identity": {
          "enum": ["observed", "reported", "inferred", "competing", "user-claim", "model-candidate", "simulated", "unknown"]
        },
        "statement": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "source_refs": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "observed_at": {
          "oneOf": [
            {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "confidence": {"enum": ["low", "medium", "high", "unknown"]},
        "event_date": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "publication_date": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "interest": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "upstream_lineage": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "supported_claim": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "cannot_prove": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "attribution": {"$ref": "#/$defs/attribution"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"identity": {"const": "user-claim"}},
            "required": ["identity"]
          },
          "then": {
            "properties": {
              "attribution": {
                "properties": {
                  "origin_kind": {"enum": ["request", "material"]},
                  "span": {"$ref": "#/$defs/byteSpan"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity": {"enum": ["observed", "reported"]}
            },
            "required": ["identity"]
          },
          "then": {
            "properties": {
              "attribution": {
                "properties": {
                  "origin_kind": {"const": "source"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity": {"enum": ["model-candidate", "simulated"]}
            },
            "required": ["identity"]
          },
          "then": {
            "properties": {
              "attribution": {
                "properties": {
                  "origin_kind": {"enum": ["model", "subagent"]},
                  "span": {"type": "null"}
                }
              }
            }
          }
        }
      ]
    },
    "byteSpan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}
      ],
      "items": false
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_kind", "origin_ref", "content_sha256", "span", "proof_grade"],
      "properties": {
        "origin_kind": {"enum": ["request", "material", "source", "model", "subagent"]},
        "origin_ref": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "content_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "span": {
          "oneOf": [
            {"$ref": "#/$defs/byteSpan"},
            {"type": "null"}
          ]
        },
        "proof_grade": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "location_ref", "description", "resolution_condition"],
      "properties": {
        "unknown_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "location_ref": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "description": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "resolution_condition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    }
  }
}
