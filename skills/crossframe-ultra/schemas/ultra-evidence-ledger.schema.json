{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-evidence-ledger.schema.json",
  "title": "CrossFrame Ultra frozen evidence ledger",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["evidence_cutoff", "entries", "unknowns"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.evidence-ledger"},
        "phase_id": {"const": "U3"},
        "evidence_cutoff": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceEntry"}
        },
        "unknowns": {
          "type": "array",
          "items": {"$ref": "#/$defs/unknown"}
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "identity", "statement", "source_refs", "observed_at", "confidence"],
      "properties": {
        "evidence_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "identity": {
          "enum": ["observed", "reported", "inferred-from-material", "competing-explanation", "user-claim", "model-candidate", "simulated-result", "unknown"]
        },
        "statement": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "source_refs": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "observed_at": {
          "oneOf": [
            {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
            {"type": "null"}
          ]
        },
        "confidence": {"enum": ["low", "medium", "high", "unknown"]}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "location_ref", "description", "resolution_condition"],
      "properties": {
        "unknown_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "location_ref": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "description": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "resolution_condition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    }
  }
}
