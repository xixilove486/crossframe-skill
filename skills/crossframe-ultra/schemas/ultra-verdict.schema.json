{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-verdict.schema.json",
  "title": "CrossFrame Ultra main and five-kind verdict bundle",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["decidability", "main_verdict", "explanation_ranking", "five_verdicts", "assumptions", "decisive_unknown_ids"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.verdict"},
        "phase_id": {"const": "U9"},
        "decidability": {"enum": ["decidable", "undecidable"]},
        "main_verdict": {"$ref": "#/$defs/mainVerdict"},
        "explanation_ranking": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rank"}},
        "five_verdicts": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/kindVerdict"}},
        "assumptions": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "decisive_unknown_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["circle_id", "benefits", "harms", "responsibility", "spillovers"],
      "properties": {
        "circle_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "benefits": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "harms": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "responsibility": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "spillovers": {"$ref": "ultra-common.schema.json#/$defs/stringArray"}
      }
    },
    "mainVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition", "scope", "epistemic_identity", "confidence", "decisive_reason_ids", "strongest_rival_id", "rival_rejection_reasons", "residual_ids", "reversal_conditions", "time_window", "indicator_ids", "action_implication", "distributions"],
      "properties": {
        "proposition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "scope": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "epistemic_identity": {"enum": ["observed", "reported", "inferred-from-material", "non-decidability"]},
        "confidence": {"enum": ["low", "medium", "high", "undetermined"]},
        "decisive_reason_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "strongest_rival_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "rival_rejection_reasons": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "residual_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "reversal_conditions": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "time_window": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "indicator_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "action_implication": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "distributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/distribution"}}
      }
    },
    "rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanation_id", "rank"],
      "properties": {
        "explanation_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "rank": {"type": "integer", "minimum": 1}
      }
    },
    "kindVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "proposition", "basis_refs", "status"],
      "properties": {
        "kind": {"enum": ["fact", "prediction", "value", "responsibility", "authorization"]},
        "proposition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "basis_refs": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "status": {"enum": ["locked", "bounded", "undecidable"]}
      }
    }
  }
}
