{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-verdict.schema.json",
  "title": "CrossFrame Ultra main and five-kind verdict bundle",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": [
        "evidence_ledger_artifact_sha256",
        "claim_mechanism_graph_artifact_sha256",
        "recursive_lineage_artifact_sha256",
        "order_evaluation_artifact_sha256",
        "red_team_report_artifact_sha256",
        "judgment_kind",
        "main_verdict",
        "non_decidability",
        "partial_ranking_justification",
        "explanation_ranking",
        "five_verdicts",
        "assumptions",
        "decisive_unknown_ids"
      ],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.verdict"},
        "phase_id": {"const": "U9"},
        "evidence_ledger_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "claim_mechanism_graph_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "recursive_lineage_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "order_evaluation_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "red_team_report_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "judgment_kind": {"enum": ["best-current", "non-decidability"]},
        "main_verdict": {
          "oneOf": [
            {"$ref": "#/$defs/mainVerdict"},
            {"type": "null"}
          ]
        },
        "non_decidability": {
          "oneOf": [
            {"$ref": "#/$defs/nonDecidability"},
            {"type": "null"}
          ]
        },
        "partial_ranking_justification": {
          "oneOf": [
            {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
            {"type": "null"}
          ]
        },
        "explanation_ranking": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/rank"}
        },
        "five_verdicts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/kindVerdict"},
          "allOf": [
            {"contains": {"properties": {"kind": {"const": "fact"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "prediction"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "value"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "responsibility"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "authorization"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "assumptions": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "decisive_unknown_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"judgment_kind": {"const": "best-current"}}, "required": ["judgment_kind"]},
          "then": {
            "properties": {
              "main_verdict": {"$ref": "#/$defs/mainVerdict"},
              "non_decidability": {"type": "null"},
              "partial_ranking_justification": {"type": "null"},
              "explanation_ranking": {
                "allOf": [
                  {"contains": {"properties": {"rank": {"const": 1}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                  {"contains": {"properties": {"rank": {"const": 2}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                  {"contains": {"properties": {"rank": {"const": 3}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                  {"contains": {"properties": {"rank": {"const": 4}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1}
                ]
              }
            }
          },
          "else": {
            "properties": {
              "main_verdict": {"type": "null"},
              "non_decidability": {"$ref": "#/$defs/nonDecidability"},
              "partial_ranking_justification": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
              "explanation_ranking": {
                "oneOf": [
                  {
                    "allOf": [
                      {"contains": {"properties": {"rank": {"const": 1}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                      {"contains": {"properties": {"rank": {"type": "null"}}, "required": ["rank"]}, "minContains": 3, "maxContains": 3}
                    ]
                  },
                  {
                    "allOf": [
                      {"contains": {"properties": {"rank": {"const": 1}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                      {"contains": {"properties": {"rank": {"const": 2}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                      {"contains": {"properties": {"rank": {"type": "null"}}, "required": ["rank"]}, "minContains": 2, "maxContains": 2}
                    ]
                  },
                  {
                    "allOf": [
                      {"contains": {"properties": {"rank": {"const": 1}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                      {"contains": {"properties": {"rank": {"const": 2}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                      {"contains": {"properties": {"rank": {"const": 3}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1},
                      {"contains": {"properties": {"rank": {"type": "null"}}, "required": ["rank"]}, "minContains": 1, "maxContains": 1}
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["circle_id", "benefits", "harms", "responsibility", "spillovers"],
      "properties": {
        "circle_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "benefits": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "harms": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "responsibility": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "spillovers": {"$ref": "ultra-common.schema.json#/$defs/stringArray"}
      }
    },
    "mainVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposition",
        "scope",
        "epistemic_identity",
        "confidence",
        "decisive_evidence_refs",
        "decisive_claim_ids",
        "decisive_mechanism_ids",
        "decisive_node_ids",
        "strongest_rival_id",
        "rival_rejection_reasons",
        "residual_ids",
        "reversal_conditions",
        "time_window",
        "indicator_ids",
        "action_implication",
        "distributions"
      ],
      "properties": {
        "proposition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "scope": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "epistemic_identity": {"enum": ["observed", "reported", "inferred-from-material"]},
        "confidence": {"enum": ["low", "medium", "high", "undetermined"]},
        "decisive_evidence_refs": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "decisive_claim_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "decisive_mechanism_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "decisive_node_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "strongest_rival_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "rival_rejection_reasons": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "residual_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "reversal_conditions": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "time_window": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "indicator_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "action_implication": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "distributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/distribution"}}
      }
    },
    "nonDecidability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_proposition", "missing_comparison_rule"],
      "properties": {
        "missing_proposition": {"$ref": "ultra-common.schema.json#/$defs/nullableString"},
        "missing_comparison_rule": {"$ref": "ultra-common.schema.json#/$defs/nullableString"}
      },
      "oneOf": [
        {
          "properties": {
            "missing_proposition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
            "missing_comparison_rule": {"type": "null"}
          }
        },
        {
          "properties": {
            "missing_proposition": {"type": "null"},
            "missing_comparison_rule": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
          }
        }
      ]
    },
    "rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanation_id", "rank"],
      "properties": {
        "explanation_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "rank": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 4},
            {"type": "null"}
          ]
        }
      }
    },
    "kindVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict_id",
        "kind",
        "proposition",
        "evidence_refs",
        "claim_ids",
        "mechanism_ids",
        "recursive_node_ids",
        "status"
      ],
      "properties": {
        "verdict_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "kind": {"enum": ["fact", "prediction", "value", "responsibility", "authorization"]},
        "proposition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "evidence_refs": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "claim_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "mechanism_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "recursive_node_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "status": {"enum": ["locked", "bounded", "undecidable"]}
      }
    }
  }
}
