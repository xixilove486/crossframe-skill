{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-host-action.schema.json",
  "title": "CrossFrame Ultra persistent host action authority",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {"action_kind": {"const": "retrieval"}},
        "required": ["action_kind"]
      },
      "then": {
        "properties": {
          "phase_id": {"const": "U2"},
          "payload": {"$ref": "#/$defs/retrievalPayload"}
        }
      }
    }
  ],
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "version_binding", "phase_id", "action_kind", "parent_event_sha256", "request_sha256", "result_relative_path", "payload", "issued_at", "action_sha256"],
  "properties": {
    "schema_id": {"const": "crossframe.ultra.v82.host-action"},
    "schema_version": {"const": 1},
    "run_id": {"$ref": "ultra-common.schema.json#/$defs/runId"},
    "version_binding": {"$ref": "ultra-common.schema.json#/$defs/currentVersionBinding"},
    "phase_id": {"$ref": "ultra-common.schema.json#/$defs/phaseId"},
    "action_kind": {"enum": ["capability-attestation", "source-read", "retrieval", "evidence-authoring", "subagent"]},
    "parent_event_sha256": {"$ref": "ultra-common.schema.json#/$defs/nullableSha256"},
    "request_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
    "result_relative_path": {"$ref": "ultra-common.schema.json#/$defs/relativePath"},
    "payload": {"type": "object"},
    "issued_at": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
    "action_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_kind", "version"],
      "properties": {
        "provider_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "provider_kind": {"enum": ["runtime", "model", "service", "local"]},
        "version": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "provider_id", "version"],
      "properties": {
        "tool_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "provider_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "version": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "retrievalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "decision_sha256", "claim_sha256", "basis_sha256", "trigger_kinds"],
      "properties": {
        "status": {"const": "required"},
        "reason": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "decision_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "claim_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "basis_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "trigger_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["real-world", "time-sensitive", "legal", "medical", "financial", "political", "product", "policy", "institutional", "current-fact"]}
        }
      }
    },
    "retrievalAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "decision_sha256", "authorization_sha256", "network_available", "outbound_authorized", "block_result"],
      "properties": {
        "status": {"const": "authorized"},
        "reason": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "decision_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "authorization_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "network_available": {"const": true},
        "outbound_authorized": {"const": true},
        "block_result": {"type": "null"}
      }
    },
    "retrievalQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibility_status", "redacted_query", "query_sha256", "eligibility_decision_sha256", "authorization_sha256", "u1_parent_event_sha256", "request_sha256", "run_id", "version_binding"],
      "properties": {
        "eligibility_status": {"const": "required"},
        "redacted_query": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "query_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "eligibility_decision_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "authorization_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "u1_parent_event_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "request_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "run_id": {"$ref": "ultra-common.schema.json#/$defs/runId"},
        "version_binding": {"$ref": "ultra-common.schema.json#/$defs/currentVersionBinding"}
      }
    },
    "retrievalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authorization", "queries", "allowed_providers", "allowed_tools", "maximum_tool_retries", "requested_result_fields"],
      "properties": {
        "decision": {"$ref": "#/$defs/retrievalDecision"},
        "authorization": {"$ref": "#/$defs/retrievalAuthorization"},
        "queries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/retrievalQuery"}
        },
        "allowed_providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/providerIdentity"}
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/toolIdentity"}
        },
        "maximum_tool_retries": {"type": "integer", "minimum": 1, "maximum": 3},
        "requested_result_fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["entries", "provider", "queries", "sources", "tool"]}
        }
      }
    }
  }
}
