{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-recursive-lineage.schema.json",
  "title": "CrossFrame Ultra order one through three recursive lineage",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["parent_volume_sha256", "nodes", "branches", "maximum_order"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.recursive-lineage"},
        "phase_id": {"const": "U7"},
        "parent_volume_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}},
        "maximum_order": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "boundedSubgraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_ids", "subgraph_sha256", "boundary_reason"],
      "properties": {
        "root_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "subgraph_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "boundary_reason": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "parent_node_ids", "order", "inherited_unknown_ids", "inherited_loss_ids", "inherited_residual_ids", "event_id", "mechanism_ids", "state_diff_sha256", "signal_refs", "evidence_identity"],
      "properties": {
        "node_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "parent_node_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "state_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "bounded_subgraph": {"$ref": "#/$defs/boundedSubgraph"},
        "inherited_unknown_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "inherited_loss_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "inherited_residual_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "event_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "mechanism_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "state_diff_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "signal_refs": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "evidence_identity": {"enum": ["inferred-from-material", "model-candidate", "simulated-result", "unknown"]}
      },
      "oneOf": [
        {"required": ["state_sha256"], "not": {"required": ["bounded_subgraph"]}},
        {"required": ["bounded_subgraph"], "not": {"required": ["state_sha256"]}}
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "kind", "node_ids", "status", "merge_parent_ids", "prune_reason", "retained_residual_ids"],
      "properties": {
        "branch_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "kind": {"enum": ["main", "strongest-rival", "mixture", "residual"]},
        "node_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "status": {"enum": ["active", "merged", "pruned", "stopped"]},
        "merge_parent_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "prune_reason": {"$ref": "ultra-common.schema.json#/$defs/nullableString"},
        "retained_residual_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"}
      }
    }
  }
}
