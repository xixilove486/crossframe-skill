{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-concept-disposition.schema.json",
  "title": "CrossFrame Ultra U5 concept closure dispositions and semantic obligations",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["evidence_artifact_sha256", "evidence_content_sha256", "world_volume_artifact_sha256", "world_volume_content_sha256", "transformation_ledger_artifact_sha256", "transformation_ledger_content_sha256", "registry_sha256", "route_map_sha256", "contract_map_sha256", "required_route_ids", "required_contract_ids", "required_requirement_ids", "dispositions", "semantic_obligations", "unvisited_concept_ids", "closure_complete"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.concept-disposition"},
        "phase_id": {"const": "U5"},
        "evidence_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "evidence_content_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "world_volume_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "world_volume_content_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "transformation_ledger_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "transformation_ledger_content_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "registry_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "route_map_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "contract_map_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "required_route_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "required_contract_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "required_requirement_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/disposition"}},
        "semantic_obligations": {"type": "array", "items": {"$ref": "#/$defs/semanticObligation"}},
        "unvisited_concept_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "closure_complete": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"closure_complete": {"const": true}},
            "required": ["closure_complete"]
          },
          "then": {
            "properties": {"unvisited_concept_ids": {"maxItems": 0}}
          }
        },
        {
          "if": {
            "properties": {
              "dispositions": {
                "contains": {
                  "type": "object",
                  "properties": {"status": {"const": "applied"}},
                  "required": ["status"]
                }
              }
            },
            "required": ["dispositions"]
          },
          "then": {
            "properties": {
              "semantic_obligations": {
                "contains": {
                  "type": "object",
                  "properties": {"status": {"const": "applied"}},
                  "required": ["status"]
                },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dispositions": {
                "contains": {
                  "type": "object",
                  "properties": {"status": {"const": "unknown-pending"}},
                  "required": ["status"]
                }
              }
            },
            "required": ["dispositions"]
          },
          "then": {
            "properties": {
              "semantic_obligations": {
                "contains": {
                  "type": "object",
                  "properties": {"status": {"const": "unknown-pending"}},
                  "required": ["status"]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "nullableIdentifier": {
      "oneOf": [
        {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "evidencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "required_evidence"],
      "properties": {
        "plan_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "required_evidence": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"}
      }
    },
    "conditionBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "condition", "evidence_plan"],
      "properties": {
        "branch_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "condition": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "evidence_plan": {"$ref": "#/$defs/evidencePlan"}
      }
    },
    "nullableConditionBranch": {
      "oneOf": [
        {"$ref": "#/$defs/conditionBranch"},
        {"type": "null"}
      ]
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "status", "rationale", "route_required", "neighbor_concept_ids", "route_ids", "contract_ids", "requirement_ids", "obligation_ids", "evidence_ids", "unknown_ids", "transformation_ids", "condition_branch"],
      "properties": {
        "concept_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "status": {"enum": ["applied", "tested-rejected", "not-applicable", "unknown-pending"]},
        "rationale": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "route_required": {"type": "boolean"},
        "neighbor_concept_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "route_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "contract_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "requirement_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "obligation_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "evidence_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "unknown_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "transformation_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "condition_branch": {"$ref": "#/$defs/nullableConditionBranch"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unknown-pending"}}, "required": ["status"]},
          "then": {"properties": {"condition_branch": {"$ref": "#/$defs/conditionBranch"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["applied", "unknown-pending"]}}, "required": ["status"]},
          "then": {"properties": {"obligation_ids": {"minItems": 1}}}
        }
      ]
    },
    "semanticObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "concept_id", "status", "semantic_unit_id", "evidence_ids", "unknown_ids", "transformation_ids", "route_ids", "contract_ids", "requirement_ids", "condition_branch_id"],
      "properties": {
        "obligation_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "concept_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "status": {"enum": ["applied", "tested-rejected", "unknown-pending"]},
        "semantic_unit_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "evidence_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "unknown_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "transformation_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "route_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "contract_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "requirement_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "condition_branch_id": {"$ref": "#/$defs/nullableIdentifier"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unknown-pending"}}, "required": ["status"]},
          "then": {"properties": {"condition_branch_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"}}}
        }
      ]
    }
  }
}
