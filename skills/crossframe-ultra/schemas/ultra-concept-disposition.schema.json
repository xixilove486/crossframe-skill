{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-concept-disposition.schema.json",
  "title": "CrossFrame Ultra concept closure dispositions",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["registry_sha256", "dispositions", "unvisited_concept_ids", "closure_complete"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.concept-disposition"},
        "phase_id": {"enum": ["U5", "U6"]},
        "registry_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/disposition"}},
        "unvisited_concept_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "closure_complete": {"type": "boolean"}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "status", "rationale", "route_required", "neighbor_concept_ids", "semantic_unit_ids", "condition_branch", "evidence_plan"],
      "properties": {
        "concept_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "status": {"enum": ["applied", "tested-rejected", "not-applicable", "unknown-pending"]},
        "rationale": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "route_required": {"type": "boolean"},
        "neighbor_concept_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "semantic_unit_ids": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "condition_branch": {"$ref": "ultra-common.schema.json#/$defs/nullableString"},
        "evidence_plan": {"$ref": "ultra-common.schema.json#/$defs/nullableString"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "applied"}}},
          "then": {"properties": {"semantic_unit_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unknown-pending"}}},
          "then": {
            "anyOf": [
              {"properties": {"condition_branch": {"type": "string"}}},
              {"properties": {"evidence_plan": {"type": "string"}}}
            ]
          }
        }
      ]
    }
  }
}
