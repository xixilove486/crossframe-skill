{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-contract-map.schema.json",
  "title": "CrossFrame Ultra v8.2 contract map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "framework_version",
    "framework_revision",
    "raw_sha256",
    "semantic_sha256",
    "contract_count",
    "contracts"
  ],
  "properties": {
    "schema_id": {"const": "crossframe.ultra.v8.2.contract-map"},
    "schema_version": {"const": 1},
    "framework_version": {"const": "v8.2"},
    "framework_revision": {"const": "v8.2"},
    "raw_sha256": {"const": "608a4e4099b18c96c18ed3c92a2ab5cdacbd737daca4214c77debdd795da3a20"},
    "semantic_sha256": {"const": "4b63a6455cf73c136ae18d124aeed4301267fd2da78cca79c74e2850fb2728b0"},
    "contract_count": {"type": "integer", "minimum": 5, "maximum": 5},
    "contracts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/contractEntry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anchor": {
      "type": "string",
      "pattern": "^V82-(?:P[0-9]{4}|T[0-9]{3})$"
    },
    "anchorArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/anchor"}
    },
    "conceptId": {"type": "string", "pattern": "^V82-M[0-9]{2,}$"},
    "conceptIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/conceptId"}
    },
    "contractId": {
      "type": "string",
      "pattern": "^V82-CONTRACT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "contractEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "file", "file_sha256", "concept_ids", "source_anchors"],
      "properties": {
        "contract_id": {"$ref": "#/$defs/contractId"},
        "file": {
          "enum": [
            "core-kernel-contracts.json",
            "transformation-contracts.json",
            "world-volume-contracts.json",
            "recursive-inference-contracts.json",
            "judgment-governance-contracts.json"
          ]
        },
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "concept_ids": {"$ref": "#/$defs/conceptIdArray"},
        "source_anchors": {"$ref": "#/$defs/anchorArray"}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "statement", "source_anchors"],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^V82-CLAUSE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "statement": {"type": "string", "minLength": 1},
        "source_anchors": {"$ref": "#/$defs/anchorArray"}
      }
    },
    "contractDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "framework_version",
        "framework_revision",
        "raw_sha256",
        "semantic_sha256",
        "contract_id",
        "responsibility",
        "source_anchors",
        "concept_ids",
        "machine_requirements",
        "clauses"
      ],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v8.2.contract"},
        "schema_version": {"const": 1},
        "framework_version": {"const": "v8.2"},
        "framework_revision": {"const": "v8.2"},
        "raw_sha256": {"const": "608a4e4099b18c96c18ed3c92a2ab5cdacbd737daca4214c77debdd795da3a20"},
        "semantic_sha256": {"const": "4b63a6455cf73c136ae18d124aeed4301267fd2da78cca79c74e2850fb2728b0"},
        "contract_id": {"$ref": "#/$defs/contractId"},
        "responsibility": {"type": "string", "minLength": 1},
        "source_anchors": {"$ref": "#/$defs/anchorArray"},
        "concept_ids": {"$ref": "#/$defs/conceptIdArray"},
        "machine_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/machineRequirement"}
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/clause"}
        }
      }
    },
    "axis": {
      "oneOf": [
        {"const": {"axis_id": "A", "canonical_zh": "聚合层次", "state_field_core": "单位、成员集、分区、聚合规则、权重、排除项", "expands_computational_witness": "目标总体覆盖源总体，目标分区是源分区的登记粗化", "non_substitution_boundary": "不得由 O、X、I 或 J 替代", "source_refs": ["V82-P0875", "V82-P0876", "V82-P0877", "V82-P0878"]}},
        {"const": {"axis_id": "X", "canonical_zh": "空间范围", "state_field_core": "坐标系、空间集合、边界通道、外部连接", "expands_computational_witness": "坐标对齐后源空间是真子集", "non_substitution_boundary": "不得由 A、O、I 或 J 替代", "source_refs": ["V82-P0879", "V82-P0880", "V82-P0881", "V82-P0882"]}},
        {"const": {"axis_id": "T", "canonical_zh": "时间跨度", "state_field_core": "时间基准、窗口角色、起止点、时滞模型", "expands_computational_witness": "同一基准与角色下目标区间真包含源区间", "non_substitution_boundary": "当前截面和长期路径不能互代", "source_refs": ["V82-P0883", "V82-P0884", "V82-P0885", "V82-P0886"]}},
        {"const": {"axis_id": "O", "canonical_zh": "组织层级", "state_field_core": "组织图、版本、节点、包含边、接口、重叠", "expands_computational_witness": "同版组织 DAG 中目标节点覆盖源节点祖先闭包", "non_substitution_boundary": "组织上位不等于 J 扩大", "source_refs": ["V82-P0887", "V82-P0888", "V82-P0889", "V82-P0890"]}},
        {"const": {"axis_id": "C", "canonical_zh": "因果层次", "state_field_core": "因果模型、变量、边、干预语义、抽象映射", "expands_computational_witness": "目标模型经语义保持映射覆盖源模型并增加可区分层面", "non_substitution_boundary": "层级标签、时序和相关不能代替因果桥", "source_refs": ["V82-P0891", "V82-P0892", "V82-P0893", "V82-P0894"]}},
        {"const": {"axis_id": "R", "canonical_zh": "观察分辨率", "state_field_core": "测量协议、可区分类、参数、误差、保护性省略", "expands_computational_witness": "目标协议保留源协议全部区分并至少细分一类", "non_substitution_boundary": "高分辨率不等于完整或有权行动", "source_refs": ["V82-P0895", "V82-P0896", "V82-P0897", "V82-P0898"]}},
        {"const": {"axis_id": "I", "canonical_zh": "影响范围", "state_field_core": "结果、阈值、窗口、受影响位置、效应阶次", "expands_computational_witness": "对齐后目标受影响位置集真包含源集合", "non_substitution_boundary": "影响和观察均不等于授权", "source_refs": ["V82-P0899", "V82-P0900", "V82-P0901", "V82-P0902"]}},
        {"const": {"axis_id": "N", "canonical_zh": "网络拓扑范围", "state_field_core": "图与版本、节点、边、语义、采样边界", "expands_computational_witness": "存在语义保持图嵌入且目标覆盖源图", "non_substitution_boundary": "网络中心不等于责任中心", "source_refs": ["V82-P0903", "V82-P0904", "V82-P0905", "V82-P0906"]}},
        {"const": {"axis_id": "J", "canonical_zh": "管辖与授权范围", "state_field_core": "原子授权元组集合；每个元组固定来源、主体、单一对象、单一动作、地域、期限、撤回、有效性和证据", "expands_computational_witness": "目标有效原子元组规范化集合真包含，且每个新增元组有独立有效性见证", "non_substitution_boundary": "任何其他轴均不能替代 J；禁止对象集与动作集做笛卡尔积", "source_refs": ["V82-P0907", "V82-P0908", "V82-P0909", "V82-P0910"]}}
      ]
    },
    "scaleProfileRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "requirement_type",
        "source_refs",
        "axes",
        "axis_relations",
        "transformation_classes",
        "axis_difference_required_fields",
        "order_witness_required_fields",
        "order_witness_invariants",
        "order_witness_registry_resolution",
        "partial_order_invariants",
        "classification_precedence",
        "j_authorization_tuple_required_fields",
        "j_expansion_invariants",
        "invariants"
      ],
      "properties": {
        "requirement_id": {"const": "V82-REQ-SP-AXES"},
        "requirement_type": {"const": "scale_profile"},
        "source_refs": {"$ref": "#/$defs/anchorArray"},
        "axes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/axis"}
        },
        "axis_relations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["equal", "expands", "contracts", "incomparable", "unknown"]}
        },
        "transformation_classes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["horizontal_or_incomparable", "mixed", "unresolved", "all_equal", "elevation", "reduction"]}
        },
        "axis_difference_required_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"enum": ["axis_id", "source_state", "target_state", "relation", "order_witness", "information_loss", "uncertainty"]}
        },
        "order_witness_required_fields": {
          "const": ["comparator_id", "comparator_version", "verifier_id", "evidence_refs", "comparison_payload", "comparator_result_ref", "verification_artifact_ref", "verification_hash", "validation_status"]
        },
        "order_witness_invariants": {
          "const": ["non_unknown_requires_closed_valid_witness", "unresolvable_witness_forces_unknown", "nontrivial_relation_requires_registered_comparator_result", "identical_states_may_use_builtin_deep_equality_for_equal", "identical_states_cannot_expand_or_contract"]
        },
        "order_witness_registry_resolution": {
          "const": {"registry": "axis_comparator_results", "match_fields": ["axis_id", "comparator_id", "comparator_version", "source_state_sha256", "target_state_sha256", "relation", "verification_hash", "validation_status"], "unresolvable_relation": "unknown", "nontrivial_relation_requires_resolved_result": true, "builtin_deep_equality_scope": "identical_states_equal_only"}
        },
        "partial_order_invariants": {
          "const": ["normalized_states_are_reflexive", "bidirectional_order_implies_same_normalized_equivalence_class", "transitivity_requires_composable_intermediate_state_version_and_witness", "arbitrary_pairwise_distance_tolerance_cannot_define_equality", "expands_requires_composable_semantics_preserving_auxiliary_mappings", "auxiliary_mapping_conflict_forces_incomparable_or_unknown"]
        },
        "classification_precedence": {
          "const": [
            {"condition": "any_incomparable", "classification": "horizontal_or_incomparable"},
            {"condition": "has_expands_and_contracts", "classification": "mixed"},
            {"condition": "any_unknown", "classification": "unresolved"},
            {"condition": "all_equal", "classification": "all_equal"},
            {"condition": "equal_or_expands_with_at_least_one_expands", "classification": "elevation"},
            {"condition": "equal_or_contracts_with_at_least_one_contracts", "classification": "reduction"}
          ]
        },
        "j_authorization_tuple_required_fields": {
          "const": ["source_ref", "decision_subject_ref", "object_ref", "action_ref", "jurisdiction", "validity_period", "revocation_conditions", "evidence_refs", "independent_review_ref"]
        },
        "j_expansion_invariants": {
          "const": ["only_valid_normalized_atomic_tuples_enter_set_comparison", "comparison_payload_lists_complete_new_target_tuples_and_validity_evidence", "comparison_payload_aligns_with_j_authorization", "multiple_objects_or_actions_require_separate_tuples", "strings_ids_claims_control_coverage_or_other_axes_cannot_make_j_expand"]
        },
        "invariants": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["all_nine_axes_are_registered", "not_applicable_is_explicit_and_never_omitted", "elevation_requires_all_axes_equal_or_expands_and_at_least_one_expands", "j_expansion_requires_new_valid_atomic_authorization_tuples", "no_other_axis_substitutes_for_j"]}
        }
      }
    },
    "rccRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "requirement_type",
        "source_refs",
        "relation_types",
        "relation_definitions",
        "required_fields",
        "invariants",
        "validation_contract"
      ],
      "properties": {
        "requirement_id": {"const": "V82-REQ-RCC-RELATION"},
        "requirement_type": {"const": "rcc_relation"},
        "source_refs": {"$ref": "#/$defs/anchorArray"},
        "relation_types": {
          "const": ["平行", "嵌套", "重叠", "桥接", "竞争", "临时"]
        },
        "relation_definitions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"const": {"relation_type": "平行", "definition": "当前无包含关系", "criteria": "共享环境与间接耦合", "failure_or_transition": "出现包含、重叠或桥接", "source_refs": ["V82-P1813", "V82-P1814", "V82-P1815", "V82-P1816"]}},
              {"const": {"relation_type": "嵌套", "definition": "明确的成员/合同/管辖/空间包含", "criteria": "下行约束与上行聚合损失", "failure_or_transition": "K 改变、退出或管辖重构", "source_refs": ["V82-P1817", "V82-P1818", "V82-P1819", "V82-P1820"]}},
              {"const": {"relation_type": "重叠", "definition": "共享部分成员、角色、资源或接口", "criteria": "角色冲突和双重计算", "failure_or_transition": "共享项消失或转为包含", "source_refs": ["V82-P1821", "V82-P1822", "V82-P1823", "V82-P1824"]}},
              {"const": {"relation_type": "桥接", "definition": "可识别的跨圈层传导接口", "criteria": "翻译、过滤、过载和代表权", "failure_or_transition": "通道关闭、替代或制度化", "source_refs": ["V82-P1825", "V82-P1826", "V82-P1827", "V82-P1828"]}},
              {"const": {"relation_type": "竞争", "definition": "对可用集合形成排他约束", "criteria": "稀缺项、时间窗、合作通道", "failure_or_transition": "资源扩张、规则协调或退出", "source_refs": ["V82-P1829", "V82-P1830", "V82-P1831", "V82-P1832"]}},
              {"const": {"relation_type": "临时", "definition": "围绕有限事件或任务形成", "criteria": "结束、留痕和责任承接", "failure_or_transition": "解体、制度化或转为其他关系", "source_refs": ["V82-P1833", "V82-P1834", "V82-P1835", "V82-P1836"]}}
            ]
          }
        },
        "required_fields": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"enum": ["source_circle_ref", "target_circle_ref", "direction", "relation_type", "shared_members_or_interfaces", "channel", "strength_or_scope", "time_window", "delay", "threshold", "evidence_refs", "counterexample_refs", "failure_conditions"]}
        },
        "invariants": {
          "type": "array",
          "const": ["one_declared_relation_per_edge", "same_pair_may_have_multiple_typed_edges_with_separate_channels_and_time_windows", "directed_multigraph_with_local_containment", "multiple_local_parents_are_allowed", "higher_does_not_imply_more_important_real_or_authorized", "shared_environment_is_not_a_direct_relation", "member_overlap_is_not_nesting", "information_contact_is_not_feedback", "transformation_is_not_a_seventh_relation_type"]
        },
        "validation_contract": {
          "const": {"record_fields": "closed_exactly_required_fields", "relation_type": "closed_to_relation_types", "evidence_refs": "runtime_evidence_ids", "counterexample_refs": "runtime_counterexample_ids", "authority_source_refs": "separate_v82_anchors"}
        }
      }
    },
    "racRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "requirement_type",
        "source_refs",
        "required_fields",
        "invariants",
        "validation_contract"
      ],
      "properties": {
        "requirement_id": {"const": "V82-REQ-RAC-MEMBERSHIP"},
        "requirement_type": {"const": "rac_membership"},
        "source_refs": {"$ref": "#/$defs/anchorArray"},
        "required_fields": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"enum": ["actor_ref", "circle_ref", "membership_basis", "start_time", "end_time", "roles", "commitment_strength", "actual_participation", "exit_ability", "dispute_status", "evidence_status", "source_refs"]}
        },
        "invariants": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"enum": ["membership_is_not_binary_or_permanent", "multiple_circle_memberships_are_allowed", "role_conflicts_and_exit_differences_are_preserved", "formal_membership_does_not_imply_action_capacity", "representation_does_not_imply_authorization", "bridge_requires_an_actual_channel_and_state_or_information_change", "representation_capacity_and_responsibility_remain_separate"]}
        },
        "validation_contract": {
          "const": {"record_fields": "closed_exactly_required_fields", "example_values": "non_normative_and_not_enumerated", "source_refs": "runtime_evidence_or_source_ids", "authority_source_refs": "separate_v82_anchors"}
        }
      }
    },
    "m02BranchRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch_id", "claim_mode", "requires_root_instance", "allowed_root_subtypes", "required_evidence_fields"],
          "properties": {
            "branch_id": {"const": "descriptive_nesting"},
            "claim_mode": {"const": "descriptive_mapping"},
            "requires_root_instance": {"const": false},
            "allowed_root_subtypes": {"const": []},
            "required_evidence_fields": {
              "type": "array",
              "const": ["boundary_refs", "member_refs", "overlap_refs", "exit_refs", "interface_mapping_refs"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch_id", "claim_mode", "requires_root_instance", "allowed_root_subtypes", "required_evidence_fields"],
          "properties": {
            "branch_id": {"const": "cross_layer_causal"},
            "claim_mode": {"const": "causal"},
            "requires_root_instance": {"const": true},
            "allowed_root_subtypes": {"const": ["G4a", "G4b"]},
            "required_evidence_fields": {
              "type": "array",
              "const": ["root_instance_ids", "success_criterion_id", "causal_bridge_refs", "causal_gate_ref", "positive_decision_rule_ref", "null_decision_rule_ref"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch_id", "claim_mode", "requires_root_instance", "allowed_root_subtypes", "required_evidence_fields"],
          "properties": {
            "branch_id": {"const": "object_conversion"},
            "claim_mode": {"const": "object_conversion"},
            "requires_root_instance": {"const": true},
            "allowed_root_subtypes": {"const": ["G4b"]},
            "required_evidence_fields": {
              "type": "array",
              "const": ["root_instance_ids", "success_criterion_id", "causal_bridge_refs", "positive_decision_rule_ref", "null_decision_rule_ref"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch_id", "claim_mode", "requires_root_instance", "allowed_root_subtypes", "required_evidence_fields"],
          "properties": {
            "branch_id": {"const": "intervention_conversion"},
            "claim_mode": {"const": "intervention_conversion"},
            "requires_root_instance": {"const": true},
            "allowed_root_subtypes": {"const": ["G4b"]},
            "required_evidence_fields": {
              "type": "array",
              "const": ["root_instance_ids", "success_criterion_id", "causal_bridge_refs", "positive_decision_rule_ref", "null_decision_rule_ref"]
            }
          }
        }
      ]
    },
    "m02Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "requirement_type", "source_refs", "concept_id", "operator_id", "branches", "success_criteria_by_root_subtype", "success_criterion_selection_cardinality", "pre_result_registration_required_fields", "pre_result_registration_match_fields", "positive_support_requires", "runtime_registry_resolution_contract", "result_states", "result_state_semantics", "null_support_requires", "forbidden_substitutions", "action_ceiling"],
      "properties": {
        "requirement_id": {"const": "V82-REQ-M02-EXECUTION"},
        "requirement_type": {"const": "m02_execution"},
        "source_refs": {"$ref": "#/$defs/anchorArray"},
        "concept_id": {"const": "V82-M02"},
        "operator_id": {"const": "scale_operator:M02"},
        "branches": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/m02BranchRequirement"}},
        "success_criteria_by_root_subtype": {
          "const": {"G4a": ["conditional_information_gain", "conditional_predictive_gain", "conditional_intervention_gain"], "G4b": ["object_dynamics_non_commutation", "intervention_non_commutation", "identity_criterion_violation", "effective_relation_change", "intervention_response_change"]}
        },
        "success_criterion_selection_cardinality": {"const": 1},
        "pre_result_registration_required_fields": {"const": ["pre_result_registration_ref", "pre_result_registration_hash"]},
