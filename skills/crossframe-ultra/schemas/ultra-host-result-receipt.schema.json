{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-host-result-receipt.schema.json",
  "title": "CrossFrame Ultra host result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "version_binding", "phase_id", "action_kind", "parent_event_sha256", "request_sha256", "action_sha256", "result_relative_path", "result_sha256", "execution_id", "completed_at", "receipt_sha256"],
  "properties": {
    "schema_id": {"const": "crossframe.ultra.v82.host-result-receipt"},
    "schema_version": {"const": 1},
    "run_id": {"$ref": "ultra-common.schema.json#/$defs/runId"},
    "version_binding": {"$ref": "ultra-common.schema.json#/$defs/currentVersionBinding"},
    "phase_id": {"$ref": "ultra-common.schema.json#/$defs/phaseId"},
    "action_kind": {"enum": ["capability-attestation", "source-read", "retrieval", "evidence-authoring", "subagent"]},
    "parent_event_sha256": {"$ref": "ultra-common.schema.json#/$defs/nullableSha256"},
    "request_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
    "action_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
    "result_relative_path": {"$ref": "ultra-common.schema.json#/$defs/relativePath"},
    "result_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
    "execution_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
    "completed_at": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
    "receipt_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
  }
}
