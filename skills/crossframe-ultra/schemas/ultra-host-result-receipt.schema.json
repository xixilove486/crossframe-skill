{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-host-result-receipt.schema.json",
  "title": "CrossFrame Ultra host result receipt",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {"action_kind": {"const": "retrieval"}},
        "required": ["action_kind"]
      },
      "then": {
        "required": ["provider", "tool", "execution_status", "attempts"],
        "properties": {
          "phase_id": {"const": "U2"},
          "provider": {"$ref": "#/$defs/providerIdentity"},
          "tool": {"$ref": "#/$defs/toolIdentity"},
          "execution_status": {"enum": ["complete", "blocked", "failed", "cancelled"]},
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"$ref": "#/$defs/executionAttempt"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"action_kind": {"const": "subagent"}},
        "required": ["action_kind"]
      },
      "then": {
        "required": ["provider", "execution_status", "attempts", "result"],
        "properties": {
          "phase_id": {"const": "U2"},
          "provider": {"$ref": "#/$defs/providerIdentity"},
          "execution_status": {"const": "complete"},
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"$ref": "#/$defs/executionAttempt"}
          },
          "result": {"$ref": "#/$defs/subagentResult"}
        }
      }
    },
    {
      "if": {
        "properties": {"action_kind": {"const": "semantic-review"}},
        "required": ["action_kind"]
      },
      "then": {
        "required": ["provider", "tool", "execution_status", "attempts"],
        "properties": {
          "phase_id": {"const": "U11"},
          "parent_event_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
          "provider": {
            "allOf": [
              {"$ref": "#/$defs/providerIdentity"},
              {"properties": {"provider_kind": {"enum": ["model", "service", "local"]}}}
            ]
          },
          "tool": {"$ref": "#/$defs/toolIdentity"},
          "execution_status": {"const": "complete"},
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"$ref": "#/$defs/executionAttempt"}
          },
          "result": false
        }
      }
    }
  ],
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "version_binding", "phase_id", "action_kind", "parent_event_sha256", "request_sha256", "action_sha256", "result_relative_path", "result_sha256", "execution_id", "completed_at", "receipt_sha256"],
  "properties": {
    "schema_id": {"const": "crossframe.ultra.v82.host-result-receipt"},
    "schema_version": {"const": 1},
    "run_id": {"$ref": "ultra-common.schema.json#/$defs/runId"},
    "version_binding": {"$ref": "ultra-common.schema.json#/$defs/currentVersionBinding"},
    "phase_id": {"$ref": "ultra-common.schema.json#/$defs/phaseId"},
    "action_kind": {"enum": ["capability-attestation", "source-read", "retrieval", "evidence-authoring", "subagent", "semantic-review"]},
    "parent_event_sha256": {"$ref": "ultra-common.schema.json#/$defs/nullableSha256"},
    "request_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
    "action_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
    "result_relative_path": {"$ref": "ultra-common.schema.json#/$defs/relativePath"},
    "result_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
    "execution_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
    "completed_at": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
    "provider": {"$ref": "#/$defs/providerIdentity"},
    "tool": {"$ref": "#/$defs/toolIdentity"},
    "execution_status": {"enum": ["complete", "blocked", "failed", "cancelled"]},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/executionAttempt"}
    },
    "result": {"$ref": "#/$defs/subagentResult"},
    "receipt_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_kind", "version"],
      "properties": {
        "provider_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "provider_kind": {"enum": ["runtime", "model", "service", "local"]},
        "version": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "provider_id", "version"],
      "properties": {
        "tool_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "provider_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "version": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "executionAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "status", "error"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "status": {"enum": ["success", "rate-limit", "timeout", "error"]},
        "error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
          ]
        }
      }
    },
    "subagentResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_candidates", "maximum_source_refs_per_candidate"],
      "properties": {
        "maximum_candidates": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_source_refs_per_candidate": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "subagentCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "role", "claim", "source_refs", "cannot_prove"],
      "properties": {
        "candidate_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "role": {"enum": ["source-discovery", "counterexample", "affected-position", "source-lineage", "calibration"]},
        "claim": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "ultra-common.schema.json#/$defs/identifier"}
        },
        "cannot_prove": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "subagentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "redacted_prompt_sha256", "resource_limits", "cannot_prove", "candidates", "content_sha256"],
      "properties": {
        "task_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "redacted_prompt_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "resource_limits": {"$ref": "#/$defs/subagentResourceLimits"},
        "cannot_prove": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/subagentCandidate"}
        },
        "content_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
      }
    }
  }
}
