{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-repair-plan.schema.json",
  "title": "CrossFrame Ultra bounded local repair plan",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["failed_report_sha256", "attempt_number", "failures", "reset_from_phase", "preserved_artifact_hashes", "repair_actions", "manifest_regeneration_required", "revalidation_required", "status"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.repair-plan"},
        "phase_id": {"const": "U12"},
        "failed_report_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3},
        "failures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failure"}},
        "reset_from_phase": {"$ref": "ultra-common.schema.json#/$defs/phaseId"},
        "preserved_artifact_hashes": {"$ref": "ultra-common.schema.json#/$defs/hashArray"},
        "repair_actions": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "manifest_regeneration_required": {"type": "boolean"},
        "revalidation_required": {"const": true},
        "status": {"enum": ["planned", "running", "complete", "needs_attention"]}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "artifact", "affected_phase", "downstream_reset", "retryable", "repair_action"],
      "properties": {
        "error_code": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "artifact": {"$ref": "ultra-common.schema.json#/$defs/relativePath"},
        "affected_phase": {"$ref": "ultra-common.schema.json#/$defs/phaseId"},
        "downstream_reset": {"$ref": "ultra-common.schema.json#/$defs/phaseArray"},
        "retryable": {"type": "boolean"},
        "repair_action": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    }
  }
}
