{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-action-ranking.schema.json",
  "title": "CrossFrame Ultra independent action ranking",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": [
        "verdict_artifact_sha256",
        "considered_verdict_ids",
        "requested_choice",
        "options",
        "ranking",
        "preferred_option_id",
        "second_option_id",
        "switch_conditions",
        "stop_conditions",
        "no_action_consequences"
      ],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.action-ranking"},
        "phase_id": {"const": "U9"},
        "verdict_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "considered_verdict_ids": {
          "allOf": [
            {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
            {"minItems": 5, "maxItems": 5}
          ]
        },
        "requested_choice": {"type": "boolean"},
        "options": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/option"},
          "allOf": [
            {"contains": {"properties": {"kind": {"const": "active"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "delay"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "probe"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "exit-or-transfer"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "maintain-status-quo"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"kind": {"const": "no-action"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "ranking": {
          "allOf": [
            {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
            {"minItems": 6, "maxItems": 6}
          ]
        },
        "preferred_option_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "second_option_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "switch_conditions": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "stop_conditions": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "no_action_consequences": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "kind",
        "description",
        "authorized",
        "authorization_verdict_id",
        "benefits",
        "harms",
        "requirements",
        "rollback"
      ],
      "properties": {
        "option_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "kind": {"enum": ["active", "delay", "probe", "exit-or-transfer", "maintain-status-quo", "no-action"]},
        "description": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "authorized": {"type": "boolean"},
        "authorization_verdict_id": {
          "oneOf": [
            {"$ref": "ultra-common.schema.json#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "benefits": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "harms": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "requirements": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "rollback": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"authorized": {"const": true}},
            "required": ["authorized"]
          },
          "then": {
            "properties": {
              "authorization_verdict_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"}
            }
          },
          "else": {
            "properties": {
              "authorization_verdict_id": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
