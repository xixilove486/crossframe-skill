{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-artifact-manifest.schema.json",
  "title": "CrossFrame Ultra hash-bound artifact manifest",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["phase_chain_head_sha256", "validator_set_sha256", "artifacts", "delivery_artifacts", "official_delivery_published"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.artifact-manifest"},
        "phase_id": {"const": "U12"},
        "phase_chain_head_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "validator_set_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/manifestArtifact"}},
        "delivery_artifacts": {"$ref": "ultra-common.schema.json#/$defs/artifactHashArray"},
        "official_delivery_published": {"type": "boolean"}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "manifestArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_id", "phase_id", "media_type"],
      "properties": {
        "path": {"$ref": "ultra-common.schema.json#/$defs/relativePath"},
        "sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "schema_id": {
          "type": "string",
          "pattern": "^crossframe\\.ultra\\.v82\\.[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "phase_id": {"$ref": "ultra-common.schema.json#/$defs/phaseId"},
        "media_type": {"$ref": "ultra-common.schema.json#/$defs/mediaType"}
      }
    }
  }
}
