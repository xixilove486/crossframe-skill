{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-output-plan.schema.json",
  "title": "CrossFrame Ultra frozen article output plan",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["article_path", "sections", "appendices", "required_artifacts", "coverage_required", "official_filename_allowed"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.output-plan"},
        "phase_id": {"const": "U10"},
        "article_path": {"$ref": "ultra-common.schema.json#/$defs/relativePath"},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
        "appendices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
        "required_artifacts": {"$ref": "ultra-common.schema.json#/$defs/nonemptyStringArray"},
        "coverage_required": {"const": true},
        "official_filename_allowed": {"type": "boolean"}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title", "ordinal", "semantic_unit_ids", "dependency_hashes"],
      "properties": {
        "section_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "title": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "ordinal": {"type": "integer", "minimum": 1},
        "semantic_unit_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "dependency_hashes": {"$ref": "ultra-common.schema.json#/$defs/hashArray"}
      }
    }
  }
}
