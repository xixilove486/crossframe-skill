{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-article-review.schema.json",
  "title": "CrossFrame Ultra blind-reader article review",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["article_sha256", "coverage_sha256", "blind_reader_fields", "quality_checks", "external_dependencies", "overall_status", "official_filename_allowed"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.article-review"},
        "phase_id": {"enum": ["U11", "U12"]},
        "article_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "coverage_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "blind_reader_fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blindReaderField"}},
        "quality_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualityCheck"}},
        "external_dependencies": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "overall_status": {"enum": ["pass", "fail", "needs-attention"]},
        "official_filename_allowed": {"type": "boolean"}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "blindReaderField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "recovered", "excerpt"],
      "properties": {
        "field_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "recovered": {"type": "boolean"},
        "excerpt": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "qualityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "evidence"],
      "properties": {
        "check_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "status": {"enum": ["pass", "fail", "blocked"]},
        "evidence": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    }
  }
}
