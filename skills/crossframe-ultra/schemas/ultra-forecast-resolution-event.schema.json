{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-forecast-resolution-event.schema.json",
  "title": "CrossFrame Ultra append-only forecast resolution event",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": [
        "resolution_event_id",
        "forecast_ledger_artifact_sha256",
        "forecast_id",
        "indicator_id",
        "original_forecast_record_sha256",
        "resolution_time",
        "observation_time",
        "indicator_resolved",
        "direction_correct",
        "time_window_covered",
        "outcome",
        "observed_value",
        "original_probability_admissible",
        "brier_inputs",
        "brier_score"
      ],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.forecast-resolution-event"},
        "phase_id": {"const": "U9"},
        "resolution_event_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "forecast_ledger_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "forecast_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "indicator_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "original_forecast_record_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "resolution_time": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
        "observation_time": {"$ref": "ultra-common.schema.json#/$defs/timestamp"},
        "indicator_resolved": {"type": "boolean"},
        "direction_correct": {"type": ["boolean", "null"]},
        "time_window_covered": {"type": "boolean"},
        "outcome": {"enum": ["correct", "incorrect", "indeterminate", "partial"]},
        "observed_value": {"type": ["number", "string", "null"]},
        "original_probability_admissible": {"type": "boolean"},
        "brier_inputs": {
          "oneOf": [
            {"$ref": "#/$defs/brierInputs"},
            {"type": "null"}
          ]
        },
        "brier_score": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "indicator_resolved": {"const": false},
                "direction_correct": {"type": "null"},
                "observed_value": {"type": "null"},
                "outcome": {"const": "indeterminate"}
              }
            },
            {
              "properties": {
                "indicator_resolved": {"const": true},
                "direction_correct": {"const": true},
                "time_window_covered": {"const": true},
                "observed_value": {"not": {"type": "null"}},
                "outcome": {"const": "correct"}
              }
            },
            {
              "properties": {
                "indicator_resolved": {"const": true},
                "direction_correct": {"const": true},
                "time_window_covered": {"const": false},
                "observed_value": {"not": {"type": "null"}},
                "outcome": {"const": "partial"}
              }
            },
            {
              "properties": {
                "indicator_resolved": {"const": true},
                "direction_correct": {"const": false},
                "observed_value": {"not": {"type": "null"}},
                "outcome": {"const": "incorrect"}
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "original_probability_admissible": {"const": true},
              "outcome": {"enum": ["correct", "incorrect", "partial"]}
            },
            "required": ["original_probability_admissible", "outcome"]
          },
          "then": {
            "properties": {
              "brier_inputs": {"$ref": "#/$defs/brierInputs"},
              "brier_score": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "else": {
            "properties": {
              "brier_inputs": {"type": "null"},
              "brier_score": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "original_probability_admissible": {"const": true},
              "outcome": {"const": "correct"}
            },
            "required": ["original_probability_admissible", "outcome"]
          },
          "then": {
            "properties": {
              "brier_inputs": {"$ref": "#/$defs/correctBrierInputs"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "original_probability_admissible": {"const": true},
              "outcome": {"enum": ["incorrect", "partial"]}
            },
            "required": ["original_probability_admissible", "outcome"]
          },
          "then": {
            "properties": {
              "brier_inputs": {"$ref": "#/$defs/incorrectBrierInputs"}
            }
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "brierInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probability", "binary_outcome"],
      "properties": {
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "binary_outcome": {"enum": [0, 1]}
      }
    },
    "correctBrierInputs": {
      "allOf": [
        {"$ref": "#/$defs/brierInputs"},
        {
          "type": "object",
          "properties": {"binary_outcome": {"const": 1}}
        }
      ]
    },
    "incorrectBrierInputs": {
      "allOf": [
        {"$ref": "#/$defs/brierInputs"},
        {
          "type": "object",
          "properties": {"binary_outcome": {"const": 0}}
        }
      ]
    }
  }
}
