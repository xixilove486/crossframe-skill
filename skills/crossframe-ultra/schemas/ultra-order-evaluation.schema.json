{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-order-evaluation.schema.json",
  "title": "CrossFrame Ultra per-order baseline and continuation evaluation",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["lineage_sha256", "evaluations"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.order-evaluation"},
        "phase_id": {"const": "U8"},
        "lineage_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "evaluations": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/evaluation"}}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "description"],
      "properties": {
        "baseline_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "description": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "branch_kinds", "baseline", "explanation_gain", "forecast_gain", "added_assumptions", "added_losses", "local_predictability", "continue_recursive", "stop_kind", "rationale"],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "branch_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["main", "strongest-rival", "mixture", "residual"]}
        },
        "baseline": {"$ref": "#/$defs/baseline"},
        "explanation_gain": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "forecast_gain": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "added_assumptions": {"$ref": "ultra-common.schema.json#/$defs/stringArray"},
        "added_losses": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "local_predictability": {"enum": ["none", "low", "bounded", "high"]},
        "continue_recursive": {"type": "boolean"},
        "stop_kind": {
          "oneOf": [
            {"enum": ["order-limit", "baseline-wins", "no-material-state-change", "local-predictability-exhausted", "evidence-boundary"]},
            {"type": "null"}
          ]
        },
        "rationale": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    }
  }
}
