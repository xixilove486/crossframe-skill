{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-red-team-report.schema.json",
  "title": "CrossFrame Ultra red-team and sensitivity report",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": [
        "claim_mechanism_graph_artifact_sha256",
        "recursive_lineage_artifact_sha256",
        "order_evaluation_artifact_sha256",
        "attacks",
        "sensitivity_checks",
        "baseline_comparisons",
        "unresolved_items",
        "overall_status"
      ],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.red-team-report"},
        "phase_id": {"const": "U8"},
        "claim_mechanism_graph_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "recursive_lineage_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "order_evaluation_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "attacks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/attack"}
        },
        "sensitivity_checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sensitivity"}
        },
        "baseline_comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/baselineComparison"}
        },
        "unresolved_items": {
          "type": "array",
          "items": {"$ref": "#/$defs/unresolvedItem"}
        },
        "overall_status": {"enum": ["survives", "revised", "rejected", "needs-attention"]}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "evidenceIdentity": {
      "enum": [
        "observed",
        "reported",
        "inferred-from-material",
        "competing-explanation",
        "user-claim",
        "model-candidate",
        "simulated-result",
        "unknown"
      ]
    },
    "attackTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id"],
          "properties": {"claim_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism_id"],
          "properties": {"mechanism_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["explanation_id"],
          "properties": {"explanation_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["recursive_node_id"],
          "properties": {"recursive_node_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch_id"],
          "properties": {"branch_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"}}
        }
      ]
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_id",
        "target",
        "attack_kind",
        "challenge",
        "evidence_refs",
        "evidence_identity",
        "result"
      ],
      "properties": {
        "attack_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "target": {"$ref": "#/$defs/attackTarget"},
        "attack_kind": {"enum": ["strongest-counterexample", "source-dependence", "identity-confusion", "baseline-challenge", "sensitivity"]},
        "challenge": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "evidence_refs": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"},
        "evidence_identity": {"$ref": "#/$defs/evidenceIdentity"},
        "result": {"enum": ["survives", "revise", "reject"]}
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "variable", "variation", "outcome"],
      "properties": {
        "check_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "variable": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "variation": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "outcome": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"}
      }
    },
    "baselineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "baseline_ref", "winner"],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "baseline_ref": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "winner": {"enum": ["lineage", "baseline", "tie", "undecidable"]}
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_item_id", "challenge_id", "description", "evidence_refs"],
      "properties": {
        "unresolved_item_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "challenge_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "description": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "evidence_refs": {"$ref": "ultra-common.schema.json#/$defs/identifierArray"}
      }
    }
  }
}
