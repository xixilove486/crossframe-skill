{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-run-migration.schema.json",
  "title": "CrossFrame Ultra immutable parent to child run migration",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/artifactEnvelope"},
    {
      "type": "object",
      "required": ["parent_run_id", "parent_checkpoint_sha256", "parent_version_binding", "compatibility_result", "fork_reason", "frozen_input_refs", "inherited_artifact_hashes"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.run-migration"},
        "parent_run_id": {"$ref": "ultra-common.schema.json#/$defs/runId"},
        "parent_checkpoint_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "parent_version_binding": {"$ref": "ultra-common.schema.json#/$defs/versionBinding"},
        "compatibility_result": {"const": "fork-required"},
        "fork_reason": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "frozen_input_refs": {
          "allOf": [
            {"$ref": "ultra-common.schema.json#/$defs/artifactHashArray"},
            {"minItems": 1}
          ]
        },
        "inherited_artifact_hashes": {
          "allOf": [
            {"$ref": "ultra-common.schema.json#/$defs/artifactHashArray"},
            {"minItems": 1}
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
