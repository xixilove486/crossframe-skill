{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-output-plan.schema.json",
  "title": "CrossFrame Ultra frozen article output plan",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/phaseArtifactEnvelope"},
    {
      "type": "object",
      "required": ["u9_parent_event_sha256", "article_path", "sections", "appendices", "required_artifacts", "semantic_universe", "semantic_universe_sha256", "blind_recovery_expectations", "coverage_required", "official_filename_allowed"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.output-plan"},
        "phase_id": {"const": "U10"},
        "u9_parent_event_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "article_path": {
          "allOf": [
            {"$ref": "ultra-common.schema.json#/$defs/relativePath"},
            {"pattern": "\\.partial\\.md$"}
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            {"$ref": "#/$defs/section01"},
            {"$ref": "#/$defs/section02"},
            {"$ref": "#/$defs/section03"},
            {"$ref": "#/$defs/section04"},
            {"$ref": "#/$defs/section05"},
            {"$ref": "#/$defs/section06"},
            {"$ref": "#/$defs/section07"},
            {"$ref": "#/$defs/section08"},
            {"$ref": "#/$defs/section09"},
            {"$ref": "#/$defs/section10"}
          ],
          "items": false
        },
        "appendices": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/appendix11"},
            {"$ref": "#/$defs/appendix12"},
            {"$ref": "#/$defs/appendix13"},
            {"$ref": "#/$defs/appendix14"},
            {"$ref": "#/$defs/appendix15"}
          ],
          "items": false
        },
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "ultra-common.schema.json#/$defs/artifactHash"}
        },
        "semantic_universe": {
          "type": "array",
          "minItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticUnit"},
          "allOf": [
            {"contains": {"properties": {"unit_kind": {"const": "claim"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "evidence"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "unknown"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "circle-relation"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "scale-transform"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "translation-loss"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "mechanism"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "branch"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "residual"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "forecast"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "verdict"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "action"}}, "required": ["unit_kind"]}, "minContains": 1},
            {"contains": {"properties": {"unit_kind": {"const": "reversal-condition"}}, "required": ["unit_kind"]}, "minContains": 1}
          ]
        },
        "semantic_universe_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "blind_recovery_expectations": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "main_verdict"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "confidence"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "steelmanned_user_position"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "decisive_evidence"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "unknowns"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "circle_relations"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "mechanisms"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "strongest_rival"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "order_1"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "order_2"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "order_3"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "five_verdicts"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "action"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "residuals"}}}]},
            {"allOf": [{"$ref": "#/$defs/blindRecoveryExpectation"}, {"properties": {"field_id": {"const": "reversal_conditions"}}}]}
          ],
          "items": false
        },
        "coverage_required": {"const": true},
        "official_filename_allowed": {"const": false}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "title", "ordinal", "semantic_unit_ids", "dependency_hashes"],
      "properties": {
        "section_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "title": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 15},
        "semantic_unit_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "dependency_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
        }
      }
    },
    "section01": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "主判断、范围和置信度"}, "ordinal": {"const": 1}}}]},
    "section02": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "用户观点的最强重建"}, "ordinal": {"const": 2}}}]},
    "section03": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "事实、证据、来源关系和未知项"}, "ordinal": {"const": 3}}}]},
    "section04": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "立体多圈层联合状态"}, "ordinal": {"const": 4}}}]},
    "section05": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "机制、真实通道和跨圈层级联"}, "ordinal": {"const": 5}}}]},
    "section06": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "竞争解释与排序"}, "ordinal": {"const": 6}}}]},
    "section07": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "一阶、二阶、三阶推演"}, "ordinal": {"const": 7}}}]},
    "section08": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "每阶简单基线、增量和停止理由"}, "ordinal": {"const": 8}}}]},
    "section09": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "事实、预测、价值、责任、授权裁决"}, "ordinal": {"const": 9}}}]},
    "section10": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "行动、不行动、切换和反转条件"}, "ordinal": {"const": 10}}}]},
    "appendix11": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "圈层—角色—尺度映射"}, "ordinal": {"const": 11}}}]},
    "appendix12": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "分支、合并、剪枝、残差和停止点"}, "ordinal": {"const": 12}}}]},
    "appendix13": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "预测、时间窗、指标和解析条件"}, "ordinal": {"const": 13}}}]},
    "appendix14": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "概念、证据和来源锚点"}, "ordinal": {"const": 14}}}]},
    "appendix15": {"allOf": [{"$ref": "#/$defs/section"}, {"properties": {"title": {"const": "未知项与框架缺口候选"}, "ordinal": {"const": 15}}}]},
    "semanticUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "unit_kind", "status", "affects_ranking", "used_in_reasoning", "promised_to_reader", "source_refs", "authority_artifact_sha256", "authority_locator", "normalized_semantic_text_sha256"],
      "properties": {
        "unit_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "unit_kind": {"$ref": "#/$defs/unitKind"},
        "status": {"enum": ["applied", "retained", "tested-rejected", "unresolved", "unknown-pending", "used-in-reasoning", "promised-to-reader", "not-applicable"]},
        "affects_ranking": {"type": "boolean"},
        "used_in_reasoning": {"type": "boolean"},
        "promised_to_reader": {"type": "boolean"},
        "source_refs": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "authority_artifact_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"},
        "authority_locator": {"$ref": "ultra-common.schema.json#/$defs/nonemptyString"},
        "normalized_semantic_text_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
      }
    },
    "blindRecoveryExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "section_id", "semantic_unit_ids", "normalized_value_sha256"],
      "properties": {
        "field_id": {"$ref": "#/$defs/blindReaderFieldId"},
        "section_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "semantic_unit_ids": {"$ref": "ultra-common.schema.json#/$defs/nonemptyIdentifierArray"},
        "normalized_value_sha256": {"$ref": "ultra-common.schema.json#/$defs/sha256"}
      }
    },
    "blindReaderFieldId": {
      "enum": ["main_verdict", "confidence", "steelmanned_user_position", "decisive_evidence", "unknowns", "circle_relations", "mechanisms", "strongest_rival", "order_1", "order_2", "order_3", "five_verdicts", "action", "residuals", "reversal_conditions"]
    },
    "unitKind": {
      "enum": ["claim", "evidence", "unknown", "circle-relation", "scale-transform", "translation-loss", "mechanism", "branch", "residual", "forecast", "verdict", "action", "reversal-condition"]
    }
  }
}
