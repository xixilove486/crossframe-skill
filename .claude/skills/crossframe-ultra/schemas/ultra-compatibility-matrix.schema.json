{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-compatibility-matrix.schema.json",
  "title": "CrossFrame Ultra mechanical compatibility matrix",
  "type": "object",
  "allOf": [
    {"$ref": "ultra-common.schema.json#/$defs/artifactEnvelope"},
    {
      "type": "object",
      "required": ["matrix_version", "binding_fields", "allowed_results", "known_migrations", "rules", "source_revision_promotion"],
      "properties": {
        "schema_id": {"const": "crossframe.ultra.v82.compatibility-matrix"},
        "matrix_version": {"const": 1},
        "binding_fields": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/bindingField"}
        },
        "allowed_results": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "resume"},
            {"const": "read-only"},
            {"const": "fork-required"},
            {"const": "reject"}
          ],
          "items": false
        },
        "known_migrations": {"$ref": "#/$defs/knownMigrations"},
        "rules": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/rule"}
        },
        "source_revision_promotion": {"$ref": "#/$defs/sourceRevisionPromotion"}
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "bindingField": {
      "enum": [
        "framework_version",
        "framework_revision",
        "framework_raw_sha256",
        "framework_semantic_sha256",
        "runtime_version",
        "artifact_schema_version",
        "compiler_version",
        "validator_version",
        "article_contract_version",
        "source_tree_sha256"
      ]
    },
    "frameworkMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_binding", "to_binding", "result"],
      "properties": {
        "from_binding": {"$ref": "ultra-common.schema.json#/$defs/versionBinding"},
        "to_binding": {"$ref": "ultra-common.schema.json#/$defs/currentVersionBinding"},
        "result": {"const": "fork-required"}
      }
    },
    "schemaMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_binding", "to_binding", "result"],
      "properties": {
        "from_binding": {"$ref": "ultra-common.schema.json#/$defs/versionBinding"},
        "to_binding": {"$ref": "ultra-common.schema.json#/$defs/currentVersionBinding"},
        "result": {"const": "fork-required"}
      }
    },
    "knownMigrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_revisions", "artifact_schemas"],
      "properties": {
        "framework_revisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/frameworkMigration"}
        },
        "artifact_schemas": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/schemaMigration"}
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "priority", "match_kind", "allowed_mismatch_fields", "result"],
      "properties": {
        "rule_id": {"$ref": "ultra-common.schema.json#/$defs/identifier"},
        "priority": {"type": "integer", "minimum": 0},
        "match_kind": {"enum": ["known-migration", "mismatch-subset", "exact", "fallback"]},
        "allowed_mismatch_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/bindingField"}
        },
        "result": {"$ref": "ultra-common.schema.json#/$defs/compatibilityResult"}
      },
      "allOf": [
        {
          "if": {
            "required": ["match_kind"],
            "properties": {"match_kind": {"const": "known-migration"}}
          },
          "then": {
            "properties": {
              "allowed_mismatch_fields": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "prefixItems": [{"const": "framework_revision"}],
                    "items": false
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "prefixItems": [{"const": "artifact_schema_version"}],
                    "items": false
                  }
                ]
              },
              "result": {"const": "fork-required"}
            }
          }
        },
        {
          "if": {
            "required": ["match_kind"],
            "properties": {"match_kind": {"const": "mismatch-subset"}}
          },
          "then": {
            "properties": {
              "allowed_mismatch_fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": ["runtime_version", "validator_version"]
                }
              },
              "result": {"const": "read-only"}
            }
          }
        },
        {
          "if": {
            "required": ["match_kind"],
            "properties": {"match_kind": {"const": "exact"}}
          },
          "then": {
            "properties": {
              "allowed_mismatch_fields": {"maxItems": 0},
              "result": {"const": "resume"}
            }
          }
        },
        {
          "if": {
            "required": ["match_kind"],
            "properties": {"match_kind": {"const": "fallback"}}
          },
          "then": {
            "properties": {
              "allowed_mismatch_fields": {"maxItems": 0},
              "result": {"const": "reject"}
            }
          }
        }
      ]
    },
    "sourceRevisionPromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_semantic", "changed_semantic"],
      "properties": {
        "same_semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "keep_revision", "build_beside_current", "requires_validation", "promote_stable_after_validation", "overwrite_existing_release"],
          "properties": {
            "action": {"const": "record-alternate-raw-package"},
            "keep_revision": {"const": true},
            "build_beside_current": {"const": false},
            "requires_validation": {"const": false},
            "promote_stable_after_validation": {"const": false},
            "overwrite_existing_release": {"const": false}
          }
        },
        "changed_semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "keep_revision", "build_beside_current", "requires_validation", "promote_stable_after_validation", "overwrite_existing_release"],
          "properties": {
            "action": {"const": "build-new-immutable-revision"},
            "keep_revision": {"const": false},
            "build_beside_current": {"const": true},
            "requires_validation": {"const": true},
            "promote_stable_after_validation": {"const": true},
            "overwrite_existing_release": {"const": false}
          }
        }
      }
    }
  }
}
