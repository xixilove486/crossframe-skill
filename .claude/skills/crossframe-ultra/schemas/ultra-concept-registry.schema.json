{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossframe.local/schemas/ultra-concept-registry.schema.json",
  "title": "CrossFrame Ultra v8.2 closed concept registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "framework_version",
    "framework_revision",
    "raw_sha256",
    "semantic_sha256",
    "canonical_namespace",
    "provisional_namespace",
    "concept_count",
    "concepts"
  ],
  "properties": {
    "schema_id": {"const": "crossframe.ultra.v8.2.concept-registry"},
    "schema_version": {"const": 1},
    "framework_version": {"const": "v8.2"},
    "framework_revision": {"const": "v8.2"},
    "raw_sha256": {"const": "608a4e4099b18c96c18ed3c92a2ab5cdacbd737daca4214c77debdd795da3a20"},
    "semantic_sha256": {"const": "4b63a6455cf73c136ae18d124aeed4301267fd2da78cca79c74e2850fb2728b0"},
    "canonical_namespace": {"const": "V82-"},
    "provisional_namespace": {"const": "ULTRA-PROV-"},
    "concept_count": {"type": "integer", "minimum": 1},
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/concept"}
    }
  },
  "$defs": {
    "anchor": {
      "type": "string",
      "pattern": "^V82-(?:P[0-9]{4}|T[0-9]{3})$"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^V82-M[0-9]{2,}$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "conceptIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/conceptId"}
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "canonical_zh",
        "concept_type",
        "responsibility_layer",
        "definition",
        "source_anchors",
        "prerequisites",
        "allowed_inferences",
        "forbidden_substitutions",
        "common_misuses",
        "required_neighbors",
        "conflicts",
        "disambiguation_conditions",
        "evidence_requirements",
        "counterexamples",
        "withdrawal_conditions",
        "inference_interfaces",
        "action_ceiling"
      ],
      "properties": {
        "concept_id": {"$ref": "#/$defs/conceptId"},
        "canonical_zh": {"$ref": "#/$defs/nonemptyString"},
        "concept_type": {"$ref": "#/$defs/nonemptyString"},
        "responsibility_layer": {"$ref": "#/$defs/nonemptyString"},
        "definition": {"$ref": "#/$defs/nonemptyString"},
        "source_anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchor"}
        },
        "prerequisites": {"$ref": "#/$defs/conceptIdArray"},
        "allowed_inferences": {"$ref": "#/$defs/stringArray"},
        "forbidden_substitutions": {"$ref": "#/$defs/stringArray"},
        "common_misuses": {"$ref": "#/$defs/stringArray"},
        "required_neighbors": {"$ref": "#/$defs/conceptIdArray"},
        "conflicts": {"$ref": "#/$defs/conceptIdArray"},
        "disambiguation_conditions": {"$ref": "#/$defs/stringArray"},
        "evidence_requirements": {"$ref": "#/$defs/stringArray"},
        "counterexamples": {"$ref": "#/$defs/stringArray"},
        "withdrawal_conditions": {"$ref": "#/$defs/stringArray"},
        "inference_interfaces": {"$ref": "#/$defs/stringArray"},
        "action_ceiling": {"$ref": "#/$defs/nonemptyString"}
      }
    }
  }
}
