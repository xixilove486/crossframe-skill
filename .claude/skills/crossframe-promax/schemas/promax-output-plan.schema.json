      "properties": {
        "article_type": {"$ref": "#/$defs/articleType"},
        "house_voice_id": {"const": "crossframe-promax"},
        "thesis_claim_id": {"$ref": "promax-common.schema.json#/$defs/claimId"},
        "stance_projection": {"$ref": "#/$defs/stanceProjection"},
        "core_concept_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "atlas_only_concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "core_concept_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/coreConceptBinding"}
        },
        "selected_techniques": {"$ref": "#/$defs/selectedTechniques"},
        "reader_beats": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/readerBeat"}
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "article_type": {"const": "reply"},
                "selected_techniques": {"$ref": "#/$defs/replySelection"}
              }
            },
            {
              "properties": {
                "article_type": {"const": "public-commentary"},
                "selected_techniques": {"$ref": "#/$defs/publicCommentarySelection"}
              }
            },
            {
              "properties": {
                "article_type": {"const": "concept-explanation"},
                "selected_techniques": {"$ref": "#/$defs/conceptExplanationSelection"}
              }
            },
            {
              "properties": {
                "article_type": {"const": "organization-review"},
                "selected_techniques": {"$ref": "#/$defs/organizationReviewSelection"}
              }
            },
            {
              "properties": {
                "article_type": {"const": "case-analysis"},
                "selected_techniques": {"$ref": "#/$defs/caseAnalysisSelection"}
              }
            },
            {
              "properties": {
                "article_type": {"const": "debate-refutation"},
                "selected_techniques": {"$ref": "#/$defs/debateRefutationSelection"}
              }
            },
            {
              "properties": {
                "article_type": {"const": "reading-synthesis"},
