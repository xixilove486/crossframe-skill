    "technique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technique_id", "tier", "paragraph_action", "section_ids"],
      "properties": {
        "technique_id": {"$ref": "#/$defs/techniqueId"},
        "tier": {"enum": ["core", "auxiliary"]},
        "paragraph_action": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        }
      }
    },
    "selectedTechniques": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/technique"},
      "allOf": [
        {
          "contains": {
            "properties": {"tier": {"const": "core"}},
            "required": ["tier"]
          },
          "minContains": 3,
          "maxContains": 3
        },
        {
          "contains": {
            "properties": {"tier": {"const": "auxiliary"}},
            "required": ["tier"]
          },
          "minContains": 0,
          "maxContains": 2
        },
        {"contains": {"properties": {"technique_id": {"const": "analogical-reasoning"}}, "required": ["technique_id"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"technique_id": {"const": "ancient-modern-global"}}, "required": ["technique_id"]}, "minContains": 0, "maxContains": 1},
