    "readerBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_id", "function", "action_ids", "section_ids", "claim_ids", "mechanism_ids", "evidence_refs", "core_concept_ids", "technique_ids"],
      "properties": {
        "beat_id": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "function": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reality_entry",
              "center_thesis",
              "mechanism_progression",
              "same_dimension_comparison",
              "strongest_counterposition",
              "explicit_position",
              "withdrawal_action_boundary",
              "resonant_close"
            ]
          }
        },
        "section_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/claimId"}
        },
        "mechanism_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "evidence_refs": {"$ref": "promax-common.schema.json#/$defs/stringArray"},
        "core_concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "promax-common.schema.json#/$defs/conceptId"}
        },
        "technique_ids": {"$ref": "promax-common.schema.json#/$defs/stringArray"}
      }
    },
    "coreConceptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "reader_anchor_terms", "source_support_spans", "source_misuse_spans", "reader_explanation"],
      "properties": {
        "concept_id": {"$ref": "promax-common.schema.json#/$defs/conceptId"},
        "reader_anchor_terms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 24,
            "pattern": "^(?=(?:.*[A-Za-z0-9\\u3400-\\u9fff]){2}).+$"
          }
        },
        "source_support_spans": {
          "type": "array",
