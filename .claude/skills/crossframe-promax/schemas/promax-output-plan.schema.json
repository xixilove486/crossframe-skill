          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 4, "maxLength": 500, "pattern": "\\S"}
        },
        "reader_explanation": {"type": "string", "minLength": 12, "maxLength": 800, "pattern": "\\S"}
      }
    },
    "stanceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_to_proposition", "judgment_strength", "center_thesis_text", "preferred_option_id", "preferred_option_kind", "preferred_option_text", "second_option_id", "second_option_kind", "second_option_text", "withdrawal_text", "action_ceiling_text"],
      "properties": {
        "relation_to_proposition": {"enum": ["supports", "rejects", "mixed", "indeterminate"]},
