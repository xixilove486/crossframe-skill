        "center_thesis_text": {"$ref": "promax-common.schema.json#/$defs/nonemptyString"},
        "preferred_option_id": {"type": ["string", "null"], "pattern": "^OPTION-[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"},
        "preferred_option_kind": {"enum": ["maintain_status_quo", "active_action", "delayed_action", "probe_action", "exit_or_transfer", "no_action", null]},
        "preferred_option_text": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "second_option_id": {"type": ["string", "null"], "pattern": "^OPTION-[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"},
        "second_option_kind": {"enum": ["maintain_status_quo", "active_action", "delayed_action", "probe_action", "exit_or_transfer", "no_action", null]},
        "second_option_text": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
