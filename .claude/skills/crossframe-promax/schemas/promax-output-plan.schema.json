            {"properties": {"technique_id": {"const": "analogical-reasoning"}, "tier": {"const": "core"}}},
            {"properties": {"technique_id": {"const": "split-wood-reasoning"}, "tier": {"const": "core"}}},
            {"properties": {"technique_id": {"const": "virtual-to-real"}, "tier": {"const": "core"}}}
