    "replySelection": {
      "allOf": [
        {"$ref": "#/$defs/selectedTechniques"},
        {
          "prefixItems": [
            {"properties": {"technique_id": {"const": "direct-emotion"}, "tier": {"const": "core"}}},
            {"properties": {"technique_id": {"const": "winding-path"}, "tier": {"const": "core"}}},
            {"properties": {"technique_id": {"const": "less-is-more"}, "tier": {"const": "core"}}}
          ],
          "items": {
            "properties": {
              "technique_id": {"enum": ["analogical-reasoning", "retreat-to-advance", "scene-emotion", "feint-attack", "hide-before-reveal", "sparse-outline"]},
              "tier": {"const": "auxiliary"}
            }
          }
        }
      ]
    },
    "publicCommentarySelection": {
      "allOf": [
        {"$ref": "#/$defs/selectedTechniques"},
        {
          "prefixItems": [
            {"properties": {"technique_id": {"const": "event-association"}, "tier": {"const": "core"}}},
            {"properties": {"technique_id": {"const": "layered-argument"}, "tier": {"const": "core"}}},
            {"properties": {"technique_id": {"const": "positive-negative-contrast"}, "tier": {"const": "core"}}}
          ],
          "items": {
            "properties": {
              "technique_id": {"enum": ["ancient-modern-global", "language-momentum", "guest-host-contrast", "point-surface", "praise-blame-interlace", "finishing-touch"]},
              "tier": {"const": "auxiliary"}
            }
          }
        }
      ]
    },
