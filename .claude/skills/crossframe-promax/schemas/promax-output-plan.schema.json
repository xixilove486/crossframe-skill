        {"contains": {"properties": {"technique_id": {"const": "scene-emotion"}}, "required": ["technique_id"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"technique_id": {"const": "small-water-waves"}}, "required": ["technique_id"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"technique_id": {"const": "sparse-outline"}}, "required": ["technique_id"]}, "minContains": 0, "maxContains": 1},
        {"contains": {"properties": {"technique_id": {"const": "split-wood-reasoning"}}, "required": ["technique_id"]}, "minContains": 0, "maxContains": 1},
