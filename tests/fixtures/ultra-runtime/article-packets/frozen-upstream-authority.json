  "mappings": [
    {"unit_id": "UNIT-MAIN-VERDICT", "unit_kind": "claim", "section_id": "reader-01", "normalized_excerpt": "现有材料最支持先缩小试点范围、保留退出通道,再依据两周内的可核查变化决定是否扩大。", "source_refs": ["EVIDENCE-1"]},
    {"unit_id": "UNIT-CONFIDENCE", "unit_kind": "evidence", "section_id": "reader-01", "normalized_excerpt": "中等;关键记录来自两个独立来源,但长期效果仍缺少观察。", "source_refs": ["EVIDENCE-1"]},
    {"unit_id": "UNIT-STEELMAN", "unit_kind": "claim", "section_id": "reader-02", "normalized_excerpt": "用户并非反对协作,而是担心一次性承诺会把可逆选择变成难以退出的责任,因此要求先证明通道有效。", "source_refs": ["USER-CLAIM-1"]},
    {"unit_id": "UNIT-DECISIVE-EVIDENCE", "unit_kind": "evidence", "section_id": "reader-03", "normalized_excerpt": "两份独立记录都显示,小范围试行时沟通延迟下降,而扩大到全部成员后延迟重新上升。", "source_refs": ["EVIDENCE-1"]},
    {"unit_id": "UNIT-UNKNOWN", "unit_kind": "unknown", "section_id": "reader-03", "normalized_excerpt": "尚不知道延迟上升来自人数、权限交叠还是同时发生的预算调整。", "source_refs": ["UNKNOWN-1"]},
    {"unit_id": "UNIT-CIRCLE-RELATION", "unit_kind": "circle-relation", "section_id": "reader-04", "normalized_excerpt": "个人圈层承担操作负担,团队圈层决定排班,组织圈层控制预算;三者通过审批与反馈两条通道连接,不能压成单一层级。", "source_refs": ["RCC-1"]},
    {"unit_id": "UNIT-MECHANISM", "unit_kind": "mechanism", "section_id": "reader-05", "normalized_excerpt": "小范围试行减少等待节点,扩大后新增审批抵消了这一收益;若审批不变,人数增长会继续放大等待时间。", "source_refs": ["MECHANISM-1"]},
    {"unit_id": "UNIT-RIVAL", "unit_kind": "branch", "section_id": "reader-06", "normalized_excerpt": "延迟变化可能主要由同期预算调整造成;它能解释部分波动,但不能解释两条独立记录中相同的审批拥堵位置。", "source_refs": ["BRANCH-RIVAL"]},
    {"unit_id": "UNIT-ORDER-1", "unit_kind": "forecast", "section_id": "reader-07", "normalized_excerpt": "保持小范围试点会在两周内继续降低直接等待。", "source_refs": ["NODE-ORDER-1"]},
    {"unit_id": "UNIT-ORDER-2", "unit_kind": "scale-transform", "section_id": "reader-07", "normalized_excerpt": "若试点扩大却不改审批,新增协调会把最初收益反转为新的拥堵。", "source_refs": ["NODE-ORDER-2"]},
    {"unit_id": "UNIT-ORDER-3", "unit_kind": "translation-loss", "section_id": "reader-07", "normalized_excerpt": "若拥堵被写入固定排班与预算规则,成员会围绕它重新分工,使之后的退出成本持续上升。", "source_refs": ["NODE-ORDER-3"]},
    {"unit_id": "UNIT-RESIDUAL", "unit_kind": "residual", "section_id": "reader-08", "normalized_excerpt": "当前推演仍未解释预算调整对延迟的独立贡献,也没有足够材料进入更高阶,因此在三阶停止。", "source_refs": ["RESIDUAL-1"]},
    {"unit_id": "UNIT-FIVE-VERDICTS", "unit_kind": "verdict", "section_id": "reader-09", "normalized_excerpt": "事实裁决为审批拥堵已被重复观察;预测裁决为扩大后延迟大概率上升;价值裁决为可逆性优先;责任裁决为审批设计者先承担修正义务;授权裁决为现阶段只授权小范围试点。", "source_refs": ["VERDICT-1"]},
    {"unit_id": "UNIT-ACTION", "unit_kind": "action", "section_id": "reader-10", "normalized_excerpt": "维持两周小范围试点,同时记录每次审批等待;若等待下降且预算因素被排除,再考虑逐步扩大。", "source_refs": ["ACTION-1"]},
    {"unit_id": "UNIT-REVERSAL", "unit_kind": "reversal-condition", "section_id": "reader-10", "normalized_excerpt": "如果独立记录显示扩大后等待没有上升,或预算调整足以解释现有差异,就撤回当前排序并重新比较方案。", "source_refs": ["REVERSAL-1"]},
    {"unit_id": "UNIT-APPENDIX-MAPPING", "unit_kind": "circle-relation", "section_id": "reader-11", "normalized_excerpt": "个人负责执行并承受即时等待,团队负责排班与反馈,组织负责预算和审批;短期观察以天为单位,中期规则变化以周为单位。", "source_refs": ["RCC-1"]},
    {"unit_id": "UNIT-APPENDIX-BRANCHES", "unit_kind": "branch", "section_id": "reader-12", "normalized_excerpt": "保留“小范围有效”和“预算调整主导”两条分支;只有出现同一时间窗、同一通道的共同证据才允许合并,证据不足的部分作为残差保留。", "source_refs": ["BRANCH-MAIN"]},
    {"unit_id": "UNIT-APPENDIX-FORECAST", "unit_kind": "forecast", "section_id": "reader-13", "normalized_excerpt": "两周时间窗内记录审批等待中位数、超时次数和退出请求;指标下降支持继续试点,指标不变或上升触发停止与复核。", "source_refs": ["FORECAST-1"]},
    {"unit_id": "UNIT-APPENDIX-SOURCES", "unit_kind": "evidence", "section_id": "reader-14", "normalized_excerpt": "文中每个判断都以可见的事实句、条件句和反例句说明作用;来源关系区分独立记录与同一上游的转述,避免把重复转述当成新增证据。", "source_refs": ["EVIDENCE-1"]},
    {"unit_id": "UNIT-APPENDIX-GAPS", "unit_kind": "unknown", "section_id": "reader-15", "normalized_excerpt": "预算调整的独立影响仍是未知项;如果后续材料持续无法区分人数与权限交叠,就把可识别性不足登记为框架缺口候选。", "source_refs": ["UNKNOWN-1"]}
